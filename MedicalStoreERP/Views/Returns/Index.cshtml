@model CustomerReturnListViewModel
@{
    ViewData["Title"] = "My Returns";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">My Orders</a></li>
            <li class="breadcrumb-item active">My Returns</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="fas fa-undo-alt me-2"></i>My Returns</h2>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h3 class="text-primary mb-0">@Model.TotalReturns</h3>
                    <small class="text-muted">Total Returns</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h3 class="text-warning mb-0">@Model.ActiveReturns</h3>
                    <small class="text-muted">Active Returns</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h3 class="text-success mb-0">₹@Model.TotalRefunded.ToString("N0")</h3>
                    <small class="text-muted">Total Refunded</small>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Returns.Any())
    {
        <div class="row g-4">
            @foreach (var returnReq in Model.Returns)
            {
                var statusClass = returnReq.Status switch
                {
                    ReturnStatus.Pending => "bg-warning text-dark",
                    ReturnStatus.Approved => "bg-info text-white",
                    ReturnStatus.ItemsReceived => "bg-primary text-white",
                    ReturnStatus.RefundProcessed => "bg-success text-white",
                    ReturnStatus.Completed => "bg-success text-white",
                    ReturnStatus.Rejected => "bg-danger text-white",
                    ReturnStatus.Cancelled => "bg-secondary text-white",
                    _ => "bg-secondary"
                };
                var statusIcon = returnReq.Status switch
                {
                    ReturnStatus.Pending => "clock",
                    ReturnStatus.Approved => "check",
                    ReturnStatus.ItemsReceived => "box",
                    ReturnStatus.RefundProcessed => "money-bill-wave",
                    ReturnStatus.Completed => "check-double",
                    ReturnStatus.Rejected => "times",
                    ReturnStatus.Cancelled => "ban",
                    _ => "question"
                };

                <div class="col-12">
                    <div class="card shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold me-3">Return #@returnReq.ReturnNumber</span>
                                <span class="badge @statusClass">
                                    <i class="fas fa-@statusIcon me-1"></i>@returnReq.StatusDisplay
                                </span>
                            </div>
                            <small class="text-muted">Submitted on @returnReq.CreatedAt.ToString("dd MMM yyyy")</small>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-8">
                                    <p class="mb-2">
                                        <i class="fas fa-shopping-bag text-muted me-2"></i>
                                        <strong>Order:</strong> @returnReq.OrderNumber
                                    </p>
                                    <p class="mb-2">
                                        <i class="fas fa-exclamation-circle text-muted me-2"></i>
                                        <strong>Reason:</strong> @returnReq.ReasonDisplay
                                    </p>
                                    <p class="mb-0">
                                        <i class="fas fa-pills text-muted me-2"></i>
                                        <strong>Items:</strong> @returnReq.Items.Count item(s)
                                    </p>

                                    @if (returnReq.Status == ReturnStatus.Rejected && !string.IsNullOrEmpty(returnReq.CancellationReason))
                                    {
                                        <div class="alert alert-danger mt-3 mb-0 py-2">
                                            <small><i class="fas fa-info-circle me-1"></i><strong>Rejection Reason:</strong> @returnReq.CancellationReason</small>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                    <div class="mb-2">
                                        <span class="text-muted">Return Amount: </span>
                                        <strong class="fs-5">₹@returnReq.TotalReturnAmount.ToString("N2")</strong>
                                    </div>
                                    @if (returnReq.RefundedAmount > 0)
                                    {
                                        <div class="mb-2 text-success">
                                            <i class="fas fa-check-circle me-1"></i>
                                            Refunded: ₹@returnReq.RefundedAmount.ToString("N2")
                                        </div>
                                    }
                                    <a asp-action="Details" asp-route-id="@returnReq.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye me-1"></i>View Details
                                    </a>
                                    @if (returnReq.Status == ReturnStatus.Pending)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" 
                                                onclick="confirmCancel(@returnReq.Id)">
                                            <i class="fas fa-times me-1"></i>Cancel
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Progress Bar for Active Returns -->
                        @if (returnReq.Status != ReturnStatus.Rejected && returnReq.Status != ReturnStatus.Cancelled)
                        {
                            <div class="card-footer bg-light">
                                <div class="d-flex justify-content-between small">
                                    @{
                                        var steps = new[] {
                                            ("Submitted", returnReq.Status >= ReturnStatus.Pending),
                                            ("Approved", returnReq.Status >= ReturnStatus.Approved),
                                            ("Items Received", returnReq.Status >= ReturnStatus.ItemsReceived),
                                            ("Refund Processed", returnReq.Status >= ReturnStatus.RefundProcessed),
                                            ("Completed", returnReq.Status >= ReturnStatus.Completed)
                                        };
                                    }
                                    @foreach (var (label, isComplete) in steps)
                                    {
                                        <div class="text-center">
                                            <i class="fas fa-@(isComplete ? "check-circle text-success" : "circle text-muted")"></i>
                                            <div class="@(isComplete ? "text-success" : "text-muted")">@label</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-undo-alt fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No Return Requests</h4>
            <p class="text-muted">You haven't submitted any return requests yet.</p>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-box me-2"></i>View My Orders
            </a>
        </div>
    }
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Cancel" method="post">
                <input type="hidden" id="cancelReturnId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title">Cancel Return Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel this return request?</p>
                    <div class="mb-3">
                        <label class="form-label">Reason (Optional)</label>
                        <textarea class="form-control" name="reason" rows="3" placeholder="Why are you cancelling?"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, Keep It</button>
                    <button type="submit" class="btn btn-danger">Yes, Cancel Return</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmCancel(returnId) {
            document.getElementById('cancelReturnId').value = returnId;
            var modal = new bootstrap.Modal(document.getElementById('cancelModal'));
            modal.show();
        }
    </script>
}
