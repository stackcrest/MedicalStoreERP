@model OrderViewModel
@{
    ViewData["Title"] = "Track Order";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Order Header -->
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-1">Order #@Model.OrderNumber</h4>
                            <p class="text-muted mb-0">Placed on @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                        </div>
                        <div>
                            @{
                                var statusClass = Model.Status switch
                                {
                                    OrderStatus.Pending => "bg-warning text-dark",
                                    OrderStatus.Processing => "bg-info",
                                    OrderStatus.Shipped => "bg-primary",
                                    OrderStatus.Delivered => "bg-success",
                                    OrderStatus.Cancelled => "bg-danger",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass fs-6 px-3 py-2">@Model.Status</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tracking Timeline -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-shipping-fast me-2 text-primary"></i>Order Tracking</h5>
                </div>
                <div class="card-body">
                    <div class="tracking-timeline">
                        <!-- Order Placed -->
                        <div class="tracking-step @(Model.Status >= OrderStatus.Pending ? "completed" : "")">
                            <div class="tracking-icon">
                                <i class="fas fa-shopping-cart"></i>
                            </div>
                            <div class="tracking-content">
                                <h6 class="mb-1">Order Placed</h6>
                                <p class="text-muted mb-0 small">@Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                                <p class="mb-0 small">Your order has been placed successfully.</p>
                            </div>
                        </div>

                        <!-- Order Confirmed/Processing -->
                        <div class="tracking-step @(Model.Status >= OrderStatus.Processing ? "completed" : "") @(Model.Status == OrderStatus.Cancelled ? "cancelled" : "")">
                            <div class="tracking-icon">
                                <i class="fas fa-cog"></i>
                            </div>
                            <div class="tracking-content">
                                <h6 class="mb-1">Processing</h6>
                                @if (Model.ConfirmedAt.HasValue)
                                {
                                    <p class="text-muted mb-0 small">@Model.ConfirmedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</p>
                                }
                                <p class="mb-0 small">
                                    @if (Model.Status >= OrderStatus.Processing)
                                    {
                                        <span>Your order is being prepared.</span>
                                    }
                                    else if (Model.Status == OrderStatus.Cancelled)
                                    {
                                        <span class="text-danger">Order was cancelled.</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Waiting for confirmation.</span>
                                    }
                                </p>
                            </div>
                        </div>

                        <!-- Shipped -->
                        <div class="tracking-step @(Model.Status >= OrderStatus.Shipped ? "completed" : "") @(Model.Status == OrderStatus.Cancelled ? "cancelled" : "")">
                            <div class="tracking-icon">
                                <i class="fas fa-truck"></i>
                            </div>
                            <div class="tracking-content">
                                <h6 class="mb-1">Shipped</h6>
                                @if (Model.ShippedAt.HasValue)
                                {
                                    <p class="text-muted mb-0 small">@Model.ShippedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</p>
                                    <p class="mb-0 small">Your order is on the way!</p>
                                }
                                else if (Model.Status == OrderStatus.Cancelled)
                                {
                                    <p class="mb-0 small text-danger">Order was cancelled.</p>
                                }
                                else
                                {
                                    <p class="mb-0 small text-muted">Waiting to be shipped.</p>
                                }
                            </div>
                        </div>

                        <!-- Delivered -->
                        <div class="tracking-step @(Model.Status == OrderStatus.Delivered ? "completed" : "") @(Model.Status == OrderStatus.Cancelled ? "cancelled" : "")">
                            <div class="tracking-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="tracking-content">
                                <h6 class="mb-1">Delivered</h6>
                                @if (Model.DeliveredAt.HasValue)
                                {
                                    <p class="text-muted mb-0 small">@Model.DeliveredAt.Value.ToString("dd MMM yyyy, hh:mm tt")</p>
                                    <p class="mb-0 small text-success">Your order has been delivered!</p>
                                }
                                else if (Model.Status == OrderStatus.Cancelled)
                                {
                                    <p class="mb-0 small text-danger">Order was cancelled.</p>
                                }
                                else
                                {
                                    <p class="mb-0 small text-muted">Estimated delivery in 3-5 business days.</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Delivery Address -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-map-marker-alt me-2 text-primary"></i>Delivery Address</h5>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>@Model.CustomerName</strong></p>
                    <p class="mb-1">@Model.DeliveryAddress</p>
                    <p class="mb-1">@Model.City, @Model.State - @Model.PinCode</p>
                    <p class="mb-0"><i class="fas fa-phone me-2"></i>@Model.CustomerPhone</p>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-box me-2 text-primary"></i>Order Summary</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.Items)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-0">@item.MedicineName</h6>
                                        <small class="text-muted">Qty: @item.Quantity × ₹@item.UnitPrice.ToString("N2")</small>
                                    </div>
                                    <span class="fw-bold">₹@item.TotalPrice.ToString("N2")</span>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between">
                        <span>Subtotal</span>
                        <span>₹@Model.SubTotal.ToString("N2")</span>
                    </div>
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between text-success">
                            <span>Discount</span>
                            <span>-₹@Model.DiscountAmount.ToString("N2")</span>
                        </div>
                    }
                    <div class="d-flex justify-content-between">
                        <span>GST</span>
                        <span>₹@Model.TotalGSTAmount.ToString("N2")</span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Total</span>
                        <span class="text-primary">₹@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Back to Orders
                </a>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="fas fa-eye me-2"></i>View Full Details
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .tracking-timeline {
        position: relative;
        padding-left: 30px;
    }

    .tracking-timeline::before {
        content: '';
        position: absolute;
        left: 15px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #e9ecef;
    }

    .tracking-step {
        position: relative;
        padding-bottom: 30px;
        padding-left: 30px;
    }

    .tracking-step:last-child {
        padding-bottom: 0;
    }

    .tracking-icon {
        position: absolute;
        left: -22px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6c757d;
        font-size: 14px;
        z-index: 1;
    }

    .tracking-step.completed .tracking-icon {
        background: #198754;
        color: white;
    }

    .tracking-step.cancelled .tracking-icon {
        background: #dc3545;
        color: white;
    }

    .tracking-content h6 {
        color: #6c757d;
    }

    .tracking-step.completed .tracking-content h6 {
        color: #198754;
    }

    .tracking-step.cancelled .tracking-content h6 {
        color: #dc3545;
    }
</style>
