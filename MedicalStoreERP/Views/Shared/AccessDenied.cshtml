@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" 
                             style="width: 100px; height: 100px;">
                            <i class="fas fa-ban text-danger" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    
                    <h2 class="fw-bold text-danger mb-3">Access Denied</h2>
                    
                    <p class="text-muted mb-4">
                        Sorry, you don't have permission to access this page. 
                        This area requires special privileges that your account doesn't have.
                    </p>
                    
                    <div class="alert alert-warning text-start mb-4">
                        <div class="d-flex align-items-start">
                            <i class="fas fa-exclamation-triangle me-3 mt-1"></i>
                            <div>
                                <strong>Why am I seeing this?</strong>
                                <ul class="mb-0 mt-2 ps-3">
                                    <li>You may not have the required role for this section</li>
                                    <li>Your session may have expired - try logging in again</li>
                                    <li>Contact an administrator if you believe this is an error</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-home me-2"></i>Go to Home
                        </a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout & Re-login
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </a>
                        }
                    </div>
                    
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="mt-4 pt-4 border-top">
                            <small class="text-muted">
                                Logged in as: <strong>@User.Identity.Name</strong>
                            </small>
                        </div>
                    }
                </div>
            </div>
            
            <div class="text-center mt-4">
                <a href="javascript:history.back()" class="text-decoration-none">
                    <i class="fas fa-arrow-left me-1"></i> Go back to previous page
                </a>
            </div>
        </div>
    </div>
</div>
