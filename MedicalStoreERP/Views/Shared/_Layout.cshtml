@inject MedicalStoreERP.Services.IAppSettingsService AppSettings
@{
    ViewData["Title"] = ViewData["Title"] ?? "Medical Store ERP";
    var settings = AppSettings.GetCachedSettings();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @settings.AppName</title>
    <meta name="description" content="@(settings.MetaDescription ?? settings.AppDescription)" />
    <meta name="keywords" content="@settings.MetaKeywords" />

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(settings.AppFavicon))
    {
        <link rel="icon" type="image/x-icon" href="@settings.AppFavicon" />
    }

    <style>
        :root {
            --primary-color: @settings.PrimaryColor;
            --secondary-color: @settings.AccentColor;
            --accent-color: #f59e0b;
            --dark-color: #1f2937;
            --light-color: #f3f4f6;
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            background-color: var(--light-color);
        }

        /* Navbar Styles */
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
        }

        .navbar-brand i {
            color: var(--secondary-color);
        }

        .nav-link {
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            transition: color 0.3s ease;
        }

        .nav-link:hover {
            color: var(--primary-color) !important;
        }

        .btn-cart {
            position: relative;
        }

        .cart-count {
            position: absolute;
            top: -8px;
            right: -8px;
            background: var(--accent-color);
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 4rem 0;
        }

        /* Product Cards */
        .product-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
        }

        .product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }

        .product-card .card-img-top {
            height: 200px;
            object-fit: cover;
        }

        .product-badge {
            position: absolute;
            top: 10px;
            left: 10px;
        }

        .discount-badge {
            background: var(--accent-color);
            color: white;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .price-original {
            text-decoration: line-through;
            color: #9ca3af;
            font-size: 0.875rem;
        }

        .price-current {
            color: var(--primary-color);
            font-weight: 700;
            font-size: 1.25rem;
        }

        /* Category Cards */
        .category-card {
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .category-card:hover {
            transform: scale(1.02);
        }

        .category-card img {
            height: 150px;
            object-fit: cover;
        }

        /* Footer */
        footer {
            background: var(--dark-color);
            color: white;
            padding: 3rem 0 1rem;
        }

        footer a {
            color: #9ca3af;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        footer a:hover {
            color: white;
        }

        /* Buttons */
        .btn-primary {
            background: var(--primary-color);
            border-color: var(--primary-color);
        }

        .btn-primary:hover {
            background: #1d4ed8;
            border-color: #1d4ed8;
        }

        .btn-success {
            background: var(--secondary-color);
            border-color: var(--secondary-color);
        }

        .btn-success:hover {
            background: #059669;
            border-color: #059669;
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            top: 80px;
            right: 20px;
            z-index: 1100;
        }

        /* Loading Spinner */
        .spinner-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }

        /* Wishlist Heart */
        .wishlist-btn {
            position: absolute;
            top: 10px;
            right: 10px;
            background: white;
            border: none;
            border-radius: 50%;
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .wishlist-btn:hover {
            background: #fee2e2;
        }

        .wishlist-btn.active i {
            color: #ef4444;
        }

        /* Stock Status */
        .stock-status {
            font-size: 0.75rem;
            font-weight: 600;
        }

        .stock-in {
            color: var(--secondary-color);
        }

        .stock-low {
            color: var(--accent-color);
        }

        .stock-out {
            color: #ef4444;
        }

        /* Breadcrumb */
        .breadcrumb-item + .breadcrumb-item::before {
            content: "›";
        }

        /* Search Box */
        .search-box {
            position: relative;
        }

        .search-box input {
            padding-left: 40px;
            border-radius: 25px;
        }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
        }

        /* Mini Cart Dropdown */
        .mini-cart {
            width: 320px;
            max-height: 400px;
            overflow-y: auto;
        }

        .mini-cart-item {
            display: flex;
            align-items: center;
            padding: 10px;
            border-bottom: 1px solid #e5e7eb;
        }

        .mini-cart-item img {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 8px;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .hero-section {
                padding: 2rem 0;
            }

            .product-card .card-img-top {
                height: 150px;
            }
        }

        /* ========== COMPREHENSIVE MOBILE RESPONSIVE STYLES ========== */
        
        /* Extra Small Devices (phones, less than 576px) */
        @@media (max-width: 575.98px) {
            /* Typography */
            h1 { font-size: 1.75rem; }
            h2 { font-size: 1.5rem; }
            h3 { font-size: 1.25rem; }
            h4 { font-size: 1.1rem; }
            
            /* Navbar */
            .navbar-brand {
                font-size: 1.2rem;
            }
            
            .search-box {
                width: 100% !important;
                margin: 1rem 0;
            }
            
            .nav-link {
                padding: 0.75rem 0.5rem !important;
            }
            
            .mini-cart {
                width: 280px !important;
                right: -50px;
            }
            
            /* Hero Section */
            .hero-section {
                padding: 1.5rem 0;
                text-align: center;
            }
            
            .hero-section h1 {
                font-size: 1.5rem;
            }
            
            .hero-section p {
                font-size: 0.9rem;
            }
            
            /* Product Cards */
            .product-card .card-img-top {
                height: 140px;
            }
            
            .product-card .card-body {
                padding: 0.75rem;
            }
            
            .product-card .card-title {
                font-size: 0.9rem;
            }
            
            .price-current {
                font-size: 1rem;
            }
            
            /* Buttons */
            .btn {
                padding: 0.5rem 0.75rem;
                font-size: 0.85rem;
            }
            
            .btn-sm {
                padding: 0.35rem 0.5rem;
                font-size: 0.75rem;
            }
            
            /* Tables */
            .table-responsive {
                font-size: 0.85rem;
            }
            
            .table td, .table th {
                padding: 0.5rem;
            }
            
            /* Forms */
            .form-control, .form-select {
                font-size: 16px; /* Prevents zoom on iOS */
            }
            
            /* Cards */
            .card {
                margin-bottom: 1rem;
            }
            
            .card-body {
                padding: 1rem;
            }
            
            /* Footer */
            footer {
                text-align: center;
                padding: 2rem 0 1rem;
            }
            
            footer .col-lg-4,
            footer .col-lg-2,
            footer .col-md-4 {
                margin-bottom: 1.5rem;
            }
            
            /* WhatsApp Button */
            .whatsapp-chat-btn {
                width: 50px;
                height: 50px;
                bottom: 15px;
                right: 15px;
            }
            
            .whatsapp-chat-btn i {
                font-size: 26px;
            }
            
            .whatsapp-tooltip {
                right: 15px;
                bottom: 75px;
                max-width: 200px;
                font-size: 0.85rem;
            }
            
            /* Category Cards */
            .category-card img {
                height: 100px;
            }
            
            /* Checkout & Cart */
            .checkout-summary {
                margin-top: 1.5rem;
            }
            
            /* Modals */
            .modal-dialog {
                margin: 0.5rem;
            }
            
            /* Pagination */
            .pagination {
                flex-wrap: wrap;
                justify-content: center;
            }
            
            .page-link {
                padding: 0.4rem 0.6rem;
                font-size: 0.85rem;
            }
            
            /* Alerts */
            .alert {
                font-size: 0.9rem;
                padding: 0.75rem 1rem;
            }
            
            /* Breadcrumb */
            .breadcrumb {
                font-size: 0.8rem;
            }
            
            /* Shop Filters */
            .filter-sidebar {
                margin-bottom: 1.5rem;
            }
            
            /* Order Details */
            .order-timeline {
                padding-left: 1rem;
            }
            
            /* Profile Page */
            .profile-header {
                text-align: center;
            }
            
            .profile-avatar {
                width: 80px;
                height: 80px;
            }
        }
        
        /* Small Devices (landscape phones, 576px to 767.98px) */
        @@media (min-width: 576px) and (max-width: 767.98px) {
            .search-box {
                width: 280px !important;
            }
            
            .product-card .card-img-top {
                height: 160px;
            }
            
            .hero-section {
                padding: 2.5rem 0;
            }
            
            .mini-cart {
                width: 300px;
            }
        }
        
        /* Medium Devices (tablets, 768px to 991.98px) */
        @@media (min-width: 768px) and (max-width: 991.98px) {
            .search-box {
                width: 320px !important;
            }
            
            .product-card .card-img-top {
                height: 180px;
            }
            
            .navbar-nav {
                align-items: flex-start;
            }
            
            .nav-item {
                width: 100%;
            }
            
            .nav-link {
                padding: 0.75rem 1rem !important;
            }
        }
        
        /* Touch Device Optimizations */
        @@media (hover: none) and (pointer: coarse) {
            .product-card:hover {
                transform: none;
            }
            
            .btn:hover {
                transform: none;
            }
            
            .wishlist-btn {
                width: 44px;
                height: 44px;
            }
            
            /* Larger touch targets */
            .nav-link {
                min-height: 44px;
                display: flex;
                align-items: center;
            }
            
            .dropdown-item {
                padding: 0.75rem 1rem;
            }
            
            .page-link {
                min-width: 44px;
                min-height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
        }
        
        /* Landscape Mode on Mobile */
        @@media (max-height: 500px) and (orientation: landscape) {
            .hero-section {
                padding: 1rem 0;
            }
            
            .navbar {
                padding: 0.25rem 0;
            }
            
            .whatsapp-chat-btn {
                width: 40px;
                height: 40px;
            }
            
            .whatsapp-chat-btn i {
                font-size: 22px;
            }
        }
        
        /* High DPI / Retina Displays */
        @@media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
            .product-card {
                box-shadow: 0 1px 4px rgba(0,0,0,0.1);
            }
        }
        
        /* Print Styles */
        @@media print {
            .navbar, footer, .whatsapp-chat-btn, .whatsapp-tooltip {
                display: none !important;
            }
            
            .card {
                box-shadow: none;
                border: 1px solid #ddd;
            }
        }
        
        /* Safe Area for Notched Devices (iPhone X and later) */
        @@supports (padding: max(0px)) {
            .navbar {
                padding-left: max(1rem, env(safe-area-inset-left));
                padding-right: max(1rem, env(safe-area-inset-right));
            }
            
            footer {
                padding-bottom: max(1rem, env(safe-area-inset-bottom));
            }
            
            .whatsapp-chat-btn {
                bottom: max(15px, env(safe-area-inset-bottom));
                right: max(15px, env(safe-area-inset-right));
            }
        }
        
        /* Utility Classes for Mobile */
        .mobile-only {
            display: none;
        }
        
        .desktop-only {
            display: block;
        }
        
        @@media (max-width: 767.98px) {
            .mobile-only {
                display: block;
            }
            
            .desktop-only {
                display: none;
            }
            
            .mobile-text-center {
                text-align: center;
            }
            
            .mobile-mb-3 {
                margin-bottom: 1rem;
            }
            
            .mobile-full-width {
                width: 100%;
            }
            
            .mobile-stack {
                flex-direction: column;
            }
            
            .mobile-gap-2 {
                gap: 0.5rem;
            }
        }

        /* WhatsApp Chat Button */
        .whatsapp-chat-btn {
            position: fixed;
            bottom: 25px;
            right: 25px;
            z-index: 1050;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #25D366;
            color: white;
            border: none;
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            animation: whatsapp-pulse 2s infinite;
        }

        .whatsapp-chat-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 20px rgba(37, 211, 102, 0.6);
        }

        .whatsapp-chat-btn i {
            font-size: 32px;
        }

        .whatsapp-tooltip {
            position: fixed;
            bottom: 95px;
            right: 25px;
            background: white;
            padding: 12px 18px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            z-index: 1049;
            display: none;
            max-width: 250px;
        }

        .whatsapp-tooltip::after {
            content: '';
            position: absolute;
            bottom: -8px;
            right: 25px;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 8px solid white;
        }

        .whatsapp-tooltip.show {
            display: block;
            animation: fadeInUp 0.3s ease;
        }

        .whatsapp-close-tooltip {
            position: absolute;
            top: 5px;
            right: 8px;
            background: none;
            border: none;
            font-size: 14px;
            color: #999;
            cursor: pointer;
        }

        @@keyframes whatsapp-pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5);
            }
            70% {
                box-shadow: 0 0 0 15px rgba(37, 211, 102, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(37, 211, 102, 0);
            }
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top" style="background-color: @settings.HeaderBgColor !important;">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrEmpty(settings.AppLogo) && settings.AppLogo != "/images/logo.png")
                {
                    <img src="@settings.AppLogo" alt="@settings.AppName" style="max-height: 40px;" class="me-2">
                }
                else
                {
                    <i class="fas fa-pills me-2"></i>
                }
                @settings.AppName
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="search-box mx-auto" style="width: 400px; max-width: 100%;">
                    <form asp-controller="Shop" asp-action="Index" method="get">
                        <i class="fas fa-search"></i>
                        <input type="text" name="search" class="form-control" placeholder="Search medicines...">
                    </form>
                </div>

                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Shop" asp-action="Index">
                            <i class="fas fa-store me-1"></i>Shop
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Blog" asp-action="Index">
                            <i class="fas fa-newspaper me-1"></i>Health Blog
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (!User.IsInRole("Admin") && !User.IsInRole("SuperAdmin"))
                        {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Wishlist" asp-action="Index">
                                <i class="fas fa-heart me-1"></i>Wishlist
                                <span class="badge bg-danger wishlist-count" style="display: none;">0</span>
                            </a>
                        </li>
                        <!-- User Notifications -->
                        <li class="nav-item dropdown">
                            <a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-bell"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-warning user-notification-count" style="display: none; font-size: 0.65rem;">
                                    0
                                </span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end p-0" style="width: 320px; max-height: 400px; overflow-y: auto;">
                                <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom bg-light">
                                    <span class="fw-semibold user-notification-header">Notifications</span>
                                    <a href="#" onclick="markAllUserNotificationsAsRead(); return false;" class="text-primary small">Mark all read</a>
                                </div>
                                <div id="userNotificationList">
                                    <div class="text-center p-3 text-muted">
                                        <i class="fas fa-bell-slash mb-2"></i>
                                        <p class="mb-0 small">No notifications</p>
                                    </div>
                                </div>
                                <div class="border-top p-2">
                                    <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">
                                        View All Orders
                                    </a>
                                </div>
                            </div>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link btn-cart" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="cart-count" id="cartCount">0</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end mini-cart p-0">
                                <div id="miniCartContent">
                                    <div class="text-center p-4 text-muted">
                                        <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                                        <p class="mb-0">Your cart is empty</p>
                                    </div>
                                </div>
                                <div class="p-3 border-top">
                                    <a asp-controller="Cart" asp-action="Index" class="btn btn-primary w-100">
                                        View Cart
                                    </a>
                                </div>
                            </div>
                        </li>
                        } @* End of customer-only section *@
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("SuperAdmin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="SuperAdmin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fas fa-crown me-2 text-warning"></i>SuperAdmin Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                else if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                        <i class="fas fa-user me-2"></i>My Profile
                                    </a>
                                </li>
                                @if (!User.IsInRole("Admin") && !User.IsInRole("SuperAdmin"))
                                {
                                <li>
                                    <a class="dropdown-item" asp-controller="Orders" asp-action="Index">
                                        <i class="fas fa-box me-2"></i>My Orders
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Returns" asp-action="Index">
                                        <i class="fas fa-undo-alt me-2"></i>My Returns
                                    </a>
                                </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="fas fa-sign-out-alt me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm ms-2" asp-controller="Account" asp-action="Register">
                                Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Main Content -->
    <main>
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="mt-5" style="background-color: @settings.FooterBgColor;">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h5>
                        @if (!string.IsNullOrEmpty(settings.AppLogo) && settings.AppLogo != "/images/logo.png")
                        {
                            <img src="@settings.AppLogo" alt="@settings.AppName" style="max-height: 30px;" class="me-2">
                        }
                        else
                        {
                            <i class="fas fa-pills me-2"></i>
                        }
                        @settings.AppName
                    </h5>
                    <p class="text-muted">@settings.AppTagline</p>
                    <div class="d-flex gap-3">
                        @if (!string.IsNullOrEmpty(settings.FacebookUrl))
                        {
                            <a href="@settings.FacebookUrl" target="_blank" rel="noopener"><i class="fab fa-facebook fa-lg"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings.TwitterUrl))
                        {
                            <a href="@settings.TwitterUrl" target="_blank" rel="noopener"><i class="fab fa-twitter fa-lg"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings.InstagramUrl))
                        {
                            <a href="@settings.InstagramUrl" target="_blank" rel="noopener"><i class="fab fa-instagram fa-lg"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings.LinkedInUrl))
                        {
                            <a href="@settings.LinkedInUrl" target="_blank" rel="noopener"><i class="fab fa-linkedin fa-lg"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(settings.YoutubeUrl))
                        {
                            <a href="@settings.YoutubeUrl" target="_blank" rel="noopener"><i class="fab fa-youtube fa-lg"></i></a>
                        }
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="text-white mb-3">Quick Links</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About">About Us</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="text-white mb-3">Categories</h6>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#">Pain Relief</a></li>
                        <li class="mb-2"><a href="#">Antibiotics</a></li>
                        <li class="mb-2"><a href="#">Vitamins</a></li>
                        <li class="mb-2"><a href="#">First Aid</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4 mb-4">
                    <h6 class="text-white mb-3">Contact Info</h6>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i>@settings.Address</li>
                        <li class="mb-2"><i class="fas fa-phone me-2"></i>@settings.Phone</li>
                        <li class="mb-2"><i class="fas fa-envelope me-2"></i>@settings.ContactEmail</li>
                        <li class="mb-2"><i class="fas fa-clock me-2"></i>@settings.SupportHours</li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0 text-muted" style="color: @settings.FooterTextColor !important;">@settings.CopyrightText</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <img src="https://via.placeholder.com/200x30?text=Payment+Methods" alt="Payment Methods" height="30">
                </div>
            </div>
        </div>
    </footer>

    <!-- WhatsApp Chat Button (Only for logged-in users and if enabled) -->
    @if (User.Identity?.IsAuthenticated == true && settings.WhatsAppEnabled && !string.IsNullOrEmpty(settings.WhatsAppNumber))
    {
        <div class="whatsapp-tooltip" id="whatsappTooltip">
            <button class="whatsapp-close-tooltip" onclick="closeWhatsAppTooltip()">&times;</button>
            <p class="mb-2 fw-bold" style="color: #25D366;"><i class="fab fa-whatsapp me-2"></i>@settings.WhatsAppButtonText</p>
            <p class="small text-muted mb-0">@settings.WhatsAppWelcomeMessage</p>
        </div>
        <button class="whatsapp-chat-btn" onclick="openWhatsAppChat()" title="@settings.WhatsAppButtonText">
            <i class="fab fa-whatsapp"></i>
        </button>
    }

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script>
        // Toast notification function
        function showToast(message, type = 'success') {
            const toastId = 'toast-' + Date.now();
            const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-warning';
            const icon = type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'exclamation-triangle';

            const toastHtml = `
                <div id="${toastId}" class="toast ${bgClass} text-white" role="alert">
                    <div class="toast-body d-flex align-items-center">
                        <i class="fas fa-${icon} me-2"></i>
                        <span>${message}</span>
                        <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            $('#toastContainer').append(toastHtml);
            const toast = new bootstrap.Toast(document.getElementById(toastId), { delay: 3000 });
            toast.show();

            document.getElementById(toastId).addEventListener('hidden.bs.toast', function () {
                this.remove();
            });
        }

        // Update cart count
        function updateCartCount() {
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>
                $.get('/Cart/GetCart', function(data) {
                    if (data.success && data.cart) {
                        var itemCount = data.cart.items ? data.cart.items.length : 0;
                        $('#cartCount').text(itemCount);
                        updateMiniCart(data.cart);
                    }
                }).fail(function() {
                    console.log('Failed to get cart');
                });
                </text>
            }
        }

        // Update mini cart display
        function updateMiniCart(cart) {
            if (!cart || !cart.items || cart.items.length === 0) {
                $('#miniCartContent').html(`
                    <div class="text-center p-4 text-muted">
                        <i class="fas fa-shopping-cart fa-2x mb-2"></i>
                        <p class="mb-0">Your cart is empty</p>
                    </div>
                `);
                return;
            }

            let html = '<div class="list-group list-group-flush">';
            cart.items.forEach(function(item) {
                html += `
                    <div class="mini-cart-item">
                        <img src="${item.imageUrl || 'https://via.placeholder.com/50'}" alt="${item.medicineName}" class="me-3">
                        <div class="flex-grow-1">
                            <h6 class="mb-0 small">${item.medicineName}</h6>
                            <small class="text-muted">${item.quantity} x ₹${item.unitPrice.toFixed(2)}</small>
                        </div>
                        <span class="fw-bold">₹${item.totalPrice.toFixed(2)}</span>
                    </div>
                `;
            });
            html += '</div>';
            html += `
                <div class="p-3 bg-light">
                    <div class="d-flex justify-content-between">
                        <span>Subtotal:</span>
                        <strong>₹${cart.subTotal.toFixed(2)}</strong>
                    </div>
                </div>
            `;

            $('#miniCartContent').html(html);
        }

        // Add to cart function
        function addToCart(medicineId, quantity = 1) {
            $.ajax({
                url: '/Cart/Add',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ medicineId: medicineId, quantity: quantity }),
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        showToast(response.message, 'success');
                        // Update cart count immediately from response
                        if (response.cartCount !== undefined) {
                            $('#cartCount').text(response.cartCount);
                        }
                        // Also refresh full cart data
                        updateCartCount();
                    } else {
                        showToast(response.message, 'error');
                    }
                },
                error: function(xhr, status, error) {
                    console.log('Cart error:', xhr.responseText);
                    showToast('Failed to add item to cart', 'error');
                }
            });
        }

        // Toggle wishlist function
        function toggleWishlist(medicineId, button) {
            $.ajax({
                url: '/Wishlist/Add',
                type: 'POST',
                data: { medicineId: medicineId },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        $(button).toggleClass('active');
                        showToast(response.message, 'success');
                    } else {
                        showToast(response.message, 'error');
                    }
                },
                error: function() {
                    showToast('Failed to update wishlist', 'error');
                }
            });
        }

        // Initialize on page load
        $(document).ready(function() {
            updateCartCount();
            
            // Load user notifications if logged in
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>
                loadUserNotifications();
                // Refresh notifications every 30 seconds
                setInterval(loadUserNotifications, 30000);
                </text>
            }

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function() {
                $('.alert').fadeOut();
            }, 5000);

            // Show WhatsApp tooltip after 3 seconds for logged-in users
            @if (User.Identity?.IsAuthenticated == true)
            {
                <text>
                setTimeout(function() {
                    if (!sessionStorage.getItem('whatsappTooltipClosed')) {
                        $('#whatsappTooltip').addClass('show');
                    }
                }, 3000);
                </text>
            }
        });

        // Load user notifications
        function loadUserNotifications() {
            $.get('/api/Notification?count=10', function(data) {
                var unreadCount = data.filter(n => !n.isRead).length;
                
                if (unreadCount > 0) {
                    $('.user-notification-count').text(unreadCount).show();
                } else {
                    $('.user-notification-count').hide();
                }
                
                $('.user-notification-header').text(data.length > 0 ? data.length + ' Notifications' : 'Notifications');
                
                if (data.length > 0) {
                    var html = '';
                    data.slice(0, 8).forEach(function(item) {
                        var iconClass = 'fa-info-circle text-info';
                        if (item.type === 'success') iconClass = 'fa-check-circle text-success';
                        else if (item.type === 'warning') iconClass = 'fa-exclamation-triangle text-warning';
                        else if (item.type === 'danger') iconClass = 'fa-times-circle text-danger';
                        
                        var bgClass = item.isRead ? '' : 'bg-light';
                        var fontClass = item.isRead ? 'text-muted' : '';
                        
                        html += `
                            <a href="${item.link || '#'}" class="d-flex align-items-start p-2 text-decoration-none border-bottom user-notification-item ${bgClass}" data-id="${item.id}">
                                <i class="fas ${iconClass} me-2 mt-1"></i>
                                <div class="flex-grow-1">
                                    <div class="small fw-semibold ${fontClass}">${item.title}</div>
                                    <div class="text-muted small">${item.message}</div>
                                    <span class="text-muted" style="font-size: 0.7rem;">${item.timeAgo}</span>
                                </div>
                            </a>
                        `;
                    });
                    $('#userNotificationList').html(html);
                    
                    // Mark as read on click
                    $('.user-notification-item').on('click', function() {
                        var id = $(this).data('id');
                        $.post('/api/Notification/' + id + '/read');
                    });
                } else {
                    $('#userNotificationList').html(`
                        <div class="text-center p-3 text-muted">
                            <i class="fas fa-bell-slash mb-2"></i>
                            <p class="mb-0 small">No notifications</p>
                        </div>
                    `);
                }
            }).fail(function() {
                console.log('Failed to load notifications');
            });
        }

        // Mark all user notifications as read
        function markAllUserNotificationsAsRead() {
            $.post('/api/Notification/read-all', function() {
                loadUserNotifications();
            });
        }

        // WhatsApp Chat Functions
        function openWhatsAppChat() {
            // Admin WhatsApp number from settings
            var adminPhone = '@settings.WhatsAppNumber';
            
            // Get user info for pre-filled message
            var userName = '@(User.Identity?.Name ?? "Customer")';
            var currentPage = window.location.href;
            var appName = '@settings.AppName';
            
            // Create pre-filled message using default message from settings
            var defaultMsg = '@settings.WhatsAppDefaultMessage';
            var message = defaultMsg.replace('{userName}', userName).replace('{page}', currentPage);
            if (!message || message === '') {
                message = `Hi ${appName} Support!\n\nI'm ${userName} and I need assistance.\n\nPage: ${currentPage}\n\nMy Query: `;
            }
            
            // Encode the message for URL
            var encodedMessage = encodeURIComponent(message);
            
            // Create WhatsApp URL
            var whatsappUrl = `https://wa.me/${adminPhone}?text=${encodedMessage}`;
            
            // Open WhatsApp in new tab
            window.open(whatsappUrl, '_blank');
            
            // Close tooltip
            closeWhatsAppTooltip();
        }

        function closeWhatsAppTooltip() {
            $('#whatsappTooltip').removeClass('show');
            sessionStorage.setItem('whatsappTooltipClosed', 'true');
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>