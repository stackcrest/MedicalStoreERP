@model CommissionIndexViewModel
@{
    ViewData["Title"] = "Commission Settings";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Commission Settings</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Commission</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Current Rate Card -->
        <div class="row">
            <div class="col-md-4">
                <div class="card card-purple card-outline">
                    <div class="card-body text-center">
                        <h1 class="display-3 text-purple">@Model.CurrentRate%</h1>
                        <p class="text-muted mb-0">Current Commission Rate</p>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h5><i class="fas fa-info-circle text-info me-2"></i>About Commission</h5>
                        <p class="text-muted mb-0">
                            The commission rate is automatically applied to all sales (online and offline). 
                            Only one commission rate can be active at a time. When you activate a new rate, 
                            the previous one is automatically deactivated. You can view detailed commission 
                            reports based on daily, weekly, monthly, or yearly sales.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Commission Settings Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-percentage me-2"></i>Commission Rates
                </h3>
                <div class="card-tools">
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="fas fa-plus me-1"></i>Add New Rate
                    </a>
                    <a asp-action="Reports" class="btn btn-info btn-sm ms-1">
                        <i class="fas fa-chart-pie me-1"></i>View Reports
                    </a>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Percentage</th>
                            <th>Min Sale</th>
                            <th>Max Sale</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th width="200">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Settings.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    <i class="fas fa-info-circle me-2"></i>No commission settings found. Create one to get started.
                                </td>
                            </tr>
                        }
                        @foreach (var setting in Model.Settings)
                        {
                            <tr class="@(setting.IsActive ? "table-success" : "")">
                                <td>
                                    <strong>@setting.Name</strong>
                                    @if (setting.IsActive)
                                    {
                                        <span class="badge bg-success ms-1">Active</span>
                                    }
                                </td>
                                <td>@(setting.Description ?? "N/A")</td>
                                <td>
                                    <span class="badge bg-purple">@setting.Percentage%</span>
                                </td>
                                <td>@(setting.MinSaleAmount.HasValue ? $"₹{setting.MinSaleAmount:N0}" : "N/A")</td>
                                <td>@(setting.MaxSaleAmount.HasValue ? $"₹{setting.MaxSaleAmount:N0}" : "N/A")</td>
                                <td>
                                    @if (setting.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>@setting.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="action-btns">
                                    @if (!setting.IsActive)
                                    {
                                        <form asp-action="SetActive" asp-route-id="@setting.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-success btn-sm" title="Activate">
                                                <i class="fas fa-check"></i> Activate
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Edit" asp-route-id="@setting.Id" class="btn btn-warning btn-sm" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (!setting.IsActive)
                                    {
                                        <form asp-action="Delete" asp-route-id="@setting.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this commission setting?');">
                                            <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
