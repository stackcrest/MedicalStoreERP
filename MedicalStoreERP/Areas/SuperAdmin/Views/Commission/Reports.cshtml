@model CommissionReportViewModel
@{
    ViewData["Title"] = "Commission Reports";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Commission Reports</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Commission</a></li>
                    <li class="breadcrumb-item active">Reports</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Card -->
        <div class="card card-primary card-outline mb-4">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-filter me-2"></i>Filter Reports
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Reports" method="get">
                    <div class="row align-items-end">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Report Type</label>
                                <select name="periodType" class="form-select">
                                    <option value="Daily" selected="@(Model.PeriodType == "Daily")">Daily</option>
                                    <option value="Weekly" selected="@(Model.PeriodType == "Weekly")">Weekly</option>
                                    <option value="Monthly" selected="@(Model.PeriodType == "Monthly")">Monthly</option>
                                    <option value="Yearly" selected="@(Model.PeriodType == "Yearly")">Yearly</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">Start Date</label>
                                <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label class="form-label">End Date</label>
                                <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="fas fa-search me-2"></i>Generate Report
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>₹@Model.TotalSales.ToString("N2")</h3>
                        <p>Total Sales</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>₹@Model.TotalCommission.ToString("N2")</h3>
                        <p>Total Commission</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-percentage"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.CommissionRate%</h3>
                        <p>Commission Rate</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-purple">
                    <div class="inner">
                        <h3>@Model.Items.Count</h3>
                        <p>@Model.PeriodType Entries</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart Row -->
        <div class="row">
            <div class="col-md-8">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-bar me-2"></i>Sales & Commission Trend
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="commissionChart" height="300"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-success card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie me-2"></i>Commission Distribution
                        </h3>
                    </div>
                    <div class="card-body">
                        <canvas id="distributionChart" height="300"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Report Table -->
        <div class="card card-info card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-table me-2"></i>@Model.PeriodType Commission Report
                </h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" id="exportExcel" title="Export to Excel">
                        <i class="fas fa-file-excel text-success"></i>
                    </button>
                    <button type="button" class="btn btn-tool" id="exportPdf" title="Export to PDF">
                        <i class="fas fa-file-pdf text-danger"></i>
                    </button>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                @if (Model.Items.Any())
                {
                    <table class="table table-striped table-hover" id="reportTable">
                        <thead class="table-dark">
                            <tr>
                                <th>Period</th>
                                <th class="text-end">Total Sales</th>
                                <th class="text-end">Commission Rate</th>
                                <th class="text-end">Commission Amount</th>
                                <th class="text-center">Orders</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.Period</strong>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-primary">₹@item.TotalSales.ToString("N2")</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-warning">@item.CommissionRate%</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="text-success fw-bold">₹@item.CommissionAmount.ToString("N2")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@item.OrderCount</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-secondary">
                            <tr>
                                <th>Total</th>
                                <th class="text-end">₹@Model.TotalSales.ToString("N2")</th>
                                <th class="text-end">@Model.CommissionRate%</th>
                                <th class="text-end">₹@Model.TotalCommission.ToString("N2")</th>
                                <th class="text-center">@Model.Items.Sum(i => i.OrderCount)</th>
                            </tr>
                        </tfoot>
                    </table>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-file-invoice fa-4x text-muted mb-3"></i>
                        <p class="text-muted">No data available for the selected period.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
            // Prepare chart data
            var labels = [@Html.Raw(string.Join(",", Model.Items.Select(i => $"'{i.Period}'")))];
            var salesData = [@Html.Raw(string.Join(",", Model.Items.Select(i => i.TotalSales)))];
            var commissionData = [@Html.Raw(string.Join(",", Model.Items.Select(i => i.CommissionAmount)))];

            // Sales & Commission Trend Chart
            var ctx = document.getElementById('commissionChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Total Sales (₹)',
                        data: salesData,
                        backgroundColor: 'rgba(54, 162, 235, 0.7)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        yAxisID: 'y'
                    }, {
                        label: 'Commission (₹)',
                        data: commissionData,
                        backgroundColor: 'rgba(75, 192, 192, 0.7)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 1,
                        type: 'line',
                        yAxisID: 'y1'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: {
                                display: true,
                                text: 'Sales (₹)'
                            }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            title: {
                                display: true,
                                text: 'Commission (₹)'
                            },
                            grid: {
                                drawOnChartArea: false
                            }
                        }
                    }
                }
            });

            // Distribution Chart
            var ctxPie = document.getElementById('distributionChart').getContext('2d');
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Net Sales', 'Commission'],
                    datasets: [{
                        data: [@(Model.TotalSales - Model.TotalCommission), @Model.TotalCommission],
                        backgroundColor: [
                            'rgba(54, 162, 235, 0.8)',
                            'rgba(75, 192, 192, 0.8)'
                        ],
                        borderColor: [
                            'rgba(54, 162, 235, 1)',
                            'rgba(75, 192, 192, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
            });

            // Export functionality placeholder
            $('#exportExcel').click(function() {
                alert('Excel export functionality - implement as needed');
            });

            $('#exportPdf').click(function() {
                alert('PDF export functionality - implement as needed');
            });
        });
    </script>
}
