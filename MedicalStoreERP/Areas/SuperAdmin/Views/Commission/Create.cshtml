@model CommissionSettingViewModel
@{
    ViewData["Title"] = "Create Commission Rate";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Create Commission Rate</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Commission</a></li>
                    <li class="breadcrumb-item active">Create</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card card-success card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-plus me-2"></i>New Commission Rate
                        </h3>
                    </div>
                    <form asp-action="Create" method="post">
                        <div class="card-body">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger">
                                    <ul class="mb-0">
                                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group">
                                        <label asp-for="Name" class="form-label">Name <span class="text-danger">*</span></label>
                                        <input asp-for="Name" class="form-control" placeholder="e.g., Standard Rate, Premium Rate" />
                                        <span asp-validation-for="Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label asp-for="Percentage" class="form-label">Percentage (%) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <input asp-for="Percentage" class="form-control" type="number" step="0.01" min="0" max="100" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <span asp-validation-for="Percentage" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3" 
                                          placeholder="Optional description for this commission rate"></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="MinSaleAmount" class="form-label">Minimum Sale Amount (₹)</label>
                                        <input asp-for="MinSaleAmount" class="form-control" type="number" step="0.01" min="0" 
                                               placeholder="Optional - Leave blank for no minimum" />
                                        <small class="form-text text-muted">Commission applies only if sale exceeds this amount</small>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label asp-for="MaxSaleAmount" class="form-label">Maximum Sale Amount (₹)</label>
                                        <input asp-for="MaxSaleAmount" class="form-control" type="number" step="0.01" min="0" 
                                               placeholder="Optional - Leave blank for no maximum" />
                                        <small class="form-text text-muted">Commission applies only if sale is below this amount</small>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="form-check">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label">
                                        Set as Active Rate
                                        <small class="text-muted d-block">
                                            If checked, this will become the active commission rate and any existing active rate will be deactivated.
                                        </small>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-2"></i>Create Commission Rate
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ms-2">
                                <i class="fas fa-arrow-left me-2"></i>Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
