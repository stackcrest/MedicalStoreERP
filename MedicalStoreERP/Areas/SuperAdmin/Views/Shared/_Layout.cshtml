@inject MedicalStoreERP.Services.IAppSettingsService AppSettings
@{
    ViewData["Title"] = ViewData["Title"] ?? "SuperAdmin Dashboard";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var appSettings = AppSettings.GetCachedSettings();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @appSettings.AppName SuperAdmin</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <!-- AdminLTE 3.4 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css" rel="stylesheet">
    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <!-- Chart.js -->
    <link href="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.min.css" rel="stylesheet">

    <style>
        :root {
            --primary-color: #7c3aed;
            --secondary-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --dark-color: #1f2937;
            --sidebar-bg: #312e81;
        }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        .main-sidebar {
            background: linear-gradient(180deg, #312e81 0%, #1e1b4b 100%);
        }

        .main-sidebar .brand-link {
            background: rgba(0,0,0,0.2);
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .nav-sidebar > .nav-item > .nav-link {
            margin: 0.25rem 0.75rem;
            border-radius: 8px;
        }

        .nav-sidebar > .nav-item > .nav-link.active {
            background: var(--primary-color) !important;
            color: white !important;
        }

        .nav-sidebar .nav-link:hover {
            background: rgba(255,255,255,0.1);
        }

        .nav-sidebar .nav-icon {
            font-size: 1rem;
            margin-right: 0.5rem;
        }

        .small-box {
            border-radius: 12px;
            overflow: hidden;
        }

        .small-box > .inner {
            padding: 1.25rem;
        }

        .small-box h3 {
            font-size: 2rem;
            font-weight: 700;
        }

        .card {
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            border: none;
        }

        .card-header {
            background: transparent;
            border-bottom: 1px solid #e5e7eb;
            padding: 1rem 1.25rem;
        }

        .card-title {
            font-weight: 600;
            margin-bottom: 0;
        }

        .table th {
            font-weight: 600;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #6b7280;
            border-bottom: 2px solid #e5e7eb;
        }

        .badge {
            font-weight: 500;
            padding: 0.35rem 0.65rem;
        }

        .btn {
            border-radius: 8px;
            font-weight: 500;
        }

        .btn-primary {
            background: var(--primary-color);
            border-color: var(--primary-color);
        }

        .btn-success {
            background: var(--secondary-color);
            border-color: var(--secondary-color);
        }

        .content-header h1 {
            font-weight: 600;
            font-size: 1.5rem;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
        }

        /* Stats Cards - SuperAdmin specific colors */
        .stats-card {
            background: linear-gradient(135deg, var(--primary-color), #8b5cf6);
            color: white;
        }

        .stats-card.green {
            background: linear-gradient(135deg, var(--secondary-color), #34d399);
        }

        .stats-card.yellow {
            background: linear-gradient(135deg, var(--warning-color), #fbbf24);
        }

        .stats-card.red {
            background: linear-gradient(135deg, var(--danger-color), #f87171);
        }

        .stats-card.purple {
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
        }

        .stats-card.indigo {
            background: linear-gradient(135deg, #4f46e5, #818cf8);
        }

        /* Charts */
        .chart-container {
            position: relative;
            height: 300px;
        }

        /* Sidebar Menu */
        .nav-header {
            font-size: 0.65rem !important;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(255,255,255,0.4) !important;
            padding: 1rem 1rem 0.5rem !important;
        }

        /* Form Controls */
        .form-control, .form-select {
            border-radius: 8px;
            border-color: #e5e7eb;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.2rem rgba(124, 58, 237, 0.15);
        }

        /* User Info */
        .user-panel {
            padding: 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        /* SuperAdmin Badge */
        .superadmin-badge {
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            color: #1f2937;
            font-weight: 600;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.65rem;
            text-transform: uppercase;
        }

        /* Action Buttons */
        .action-btns .btn {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
        }

        /* Pagination */
        .pagination .page-link {
            border-radius: 8px;
            margin: 0 2px;
        }

        .pagination .page-item.active .page-link {
            background: var(--primary-color);
            border-color: var(--primary-color);
        }

        /* Role Badges */
        .role-superadmin {
            background: linear-gradient(135deg, #7c3aed, #a78bfa);
            color: white;
        }

        .role-admin {
            background: #2563eb;
            color: white;
        }

        .role-user {
            background: #6b7280;
            color: white;
        }

        /* ========== COMPREHENSIVE MOBILE RESPONSIVE STYLES ========== */
        
        /* Small Devices (phones) */
        @@media (max-width: 575.98px) {
            .content-header h1 {
                font-size: 1.25rem;
            }
            
            .breadcrumb {
                font-size: 0.75rem;
            }
            
            .small-box h3 {
                font-size: 1.5rem;
            }
            
            .small-box p {
                font-size: 0.85rem;
            }
            
            .small-box > .inner {
                padding: 0.75rem;
            }
            
            .card-body {
                padding: 0.75rem;
            }
            
            .card-header {
                padding: 0.75rem;
            }
            
            .card-title {
                font-size: 1rem;
            }
            
            .table {
                font-size: 0.8rem;
            }
            
            .table td, .table th {
                padding: 0.5rem 0.35rem;
            }
            
            .action-btns {
                display: flex;
                flex-direction: column;
                gap: 0.25rem;
            }
            
            .action-btns .btn {
                width: 100%;
                margin: 0 !important;
            }
            
            .btn {
                padding: 0.5rem 0.75rem;
                font-size: 0.85rem;
            }
            
            .btn-sm {
                padding: 0.35rem 0.5rem;
                font-size: 0.75rem;
            }
            
            .form-control, .form-select {
                font-size: 16px;
            }
            
            .pagination .page-link {
                padding: 0.4rem 0.6rem;
                font-size: 0.8rem;
            }
            
            .badge {
                font-size: 0.7rem;
                padding: 0.25rem 0.4rem;
            }
            
            .chart-container {
                height: 200px;
            }
            
            .modal-dialog {
                margin: 0.5rem;
            }
            
            .superadmin-badge {
                font-size: 0.55rem;
            }
            
            .user-panel {
                padding: 0.75rem;
            }
            
            .nav-header {
                padding: 0.75rem 0.75rem 0.35rem !important;
            }
            
            .dataTables_wrapper .dataTables_length,
            .dataTables_wrapper .dataTables_filter,
            .dataTables_wrapper .dataTables_info,
            .dataTables_wrapper .dataTables_paginate {
                text-align: center;
                float: none;
                padding: 0.5rem 0;
            }
            
            .dataTables_wrapper .dataTables_filter input {
                width: 100%;
                margin-left: 0;
            }
        }
        
        /* Medium Devices (tablets) */
        @@media (min-width: 576px) and (max-width: 991.98px) {
            .small-box h3 {
                font-size: 1.75rem;
            }
            
            .chart-container {
                height: 250px;
            }
        }
        
        /* Sidebar collapsed state for mobile */
        @@media (max-width: 991.98px) {
            .sidebar-mini.sidebar-collapse .main-sidebar {
                margin-left: -250px;
            }
            
            .sidebar-mini.sidebar-collapse .content-wrapper {
                margin-left: 0 !important;
            }
            
            .content-wrapper {
                margin-left: 0 !important;
            }
        }
        
        /* Touch Device Optimizations */
        @@media (hover: none) and (pointer: coarse) {
            .nav-link {
                min-height: 44px;
                display: flex;
                align-items: center;
            }
            
            .dropdown-item {
                padding: 0.75rem 1rem;
            }
            
            .page-link {
                min-width: 44px;
                min-height: 44px;
                display: flex;
                align-items: center;
                justify-content: center;
            }
        }
        
        /* Print Styles */
        @@media print {
            .main-sidebar, .main-header, .main-footer {
                display: none !important;
            }
            
            .content-wrapper {
                margin-left: 0 !important;
            }
        }
    </style>
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="nav-link">
                        <i class="fas fa-external-link-alt me-1"></i>Visit Store
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">
                        <i class="fas fa-user-shield me-1"></i>Admin Panel
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <span class="nav-link superadmin-badge">
                        <i class="fas fa-crown me-1"></i>SuperAdmin
                    </span>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-toggle="dropdown">
                        <i class="fas fa-user-circle me-1"></i>@User.Identity?.Name
                    </a>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile">
                            <i class="fas fa-user me-2"></i>Profile
                        </a>
                        <div class="dropdown-divider"></div>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="fas fa-sign-out-alt me-2"></i>Logout
                            </button>
                        </form>
                    </div>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <a asp-action="Index" asp-controller="Dashboard" class="brand-link text-center">
                <i class="fas fa-crown text-warning"></i>
                <span class="brand-text font-weight-bold ms-2">SuperAdmin</span>
            </a>

            <div class="sidebar">
                <div class="user-panel d-flex">
                    <div class="image">
                        <i class="fas fa-user-shield fa-2x text-warning"></i>
                    </div>
                    <div class="info">
                        <a href="#" class="d-block text-light">@User.Identity?.Name</a>
                        <small class="superadmin-badge">Super Administrator</small>
                    </div>
                </div>

                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu">
                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index" 
                               class="nav-link @(currentController == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>

                        <li class="nav-header">USER MANAGEMENT</li>
                        <li class="nav-item">
                            <a asp-controller="Users" asp-action="Index" 
                               class="nav-link @(currentController == "Users" ? "active" : "")">
                                <i class="nav-icon fas fa-users-cog"></i>
                                <p>Manage Users</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Users" asp-action="Create" 
                               class="nav-link @(currentAction == "Create" && currentController == "Users" ? "active" : "")">
                                <i class="nav-icon fas fa-user-plus"></i>
                                <p>Create User</p>
                            </a>
                        </li>

                        <li class="nav-header">COMMISSION & SALES</li>
                        <li class="nav-item">
                            <a asp-controller="Commission" asp-action="Index" 
                               class="nav-link @(currentController == "Commission" && currentAction == "Index" ? "active" : "")">
                                <i class="nav-icon fas fa-percentage"></i>
                                <p>Commission Settings</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Commission" asp-action="Reports" 
                               class="nav-link @(currentController == "Commission" && currentAction == "Reports" ? "active" : "")">
                                <i class="nav-icon fas fa-chart-pie"></i>
                                <p>Commission Reports</p>
                            </a>
                        </li>

                        <li class="nav-header">APP SETTINGS</li>
                        <li class="nav-item">
                            <a asp-controller="Settings" asp-action="Index" 
                               class="nav-link @(currentController == "Settings" ? "active" : "")">
                                <i class="nav-icon fas fa-cogs"></i>
                                <p>Application Settings</p>
                            </a>
                        </li>

                        <li class="nav-header">QUICK LINKS</li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-user-shield"></i>
                                <p>Admin Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Reports" asp-action="Sales" class="nav-link">
                                <i class="nav-icon fas fa-chart-line"></i>
                                <p>Sales Reports</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-shopping-cart"></i>
                                <p>Orders</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            @if (TempData["Warning"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show m-3" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Warning"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }
            @RenderBody()
        </div>

        <!-- Footer -->
        <footer class="main-footer">
            <strong>&copy; @DateTime.Now.Year @appSettings.AppName</strong>
            <div class="float-right d-none d-sm-inline-block">
                <b>SuperAdmin Panel</b> v1.0
            </div>
        </footer>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- Bootstrap 4 Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE -->
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
