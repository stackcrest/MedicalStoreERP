@model List<MedicalStoreERP.Models.ViewModels.SettingsEditViewModel>
@{
    ViewData["Title"] = "Application Settings";
    Layout = "~/Areas/SuperAdmin/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1><i class="fas fa-cogs me-2"></i>Application Settings</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Settings</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            <!-- Settings Groups Navigation -->
            <div class="col-md-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-list me-2"></i>Settings Groups</h5>
                    </div>
                    <div class="list-group list-group-flush">
                        @foreach (var group in Model)
                        {
                            <a href="#@group.Group" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-bs-toggle="collapse">
                                @group.GroupDisplayName
                                <span class="badge bg-secondary rounded-pill">@group.Settings.Count</span>
                            </a>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-action="Preview" class="btn btn-outline-primary btn-sm w-100 mb-2" target="_blank">
                            <i class="fas fa-eye me-1"></i>Preview Site
                        </a>
                    </div>
                </div>

                <!-- Quick Stats -->
                <div class="card shadow-sm mt-3">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Quick Info</h6>
                    </div>
                    <div class="card-body">
                        <small class="text-muted">
                            <p class="mb-1"><strong>Total Settings:</strong> @Model.Sum(g => g.Settings.Count)</p>
                            <p class="mb-1"><strong>Groups:</strong> @Model.Count</p>
                            <p class="mb-0"><strong>Last Updated:</strong><br>
                                @{
                                    var lastUpdate = Model.SelectMany(g => g.Settings).Where(s => s.UpdatedAt.HasValue).OrderByDescending(s => s.UpdatedAt).FirstOrDefault();
                                }
                                @if (lastUpdate != null)
                                {
                                    @lastUpdate.UpdatedAt?.ToString("MMM dd, yyyy HH:mm")
                                }
                                else
                                {
                                    <text>Never</text>
                                }
                            </p>
                        </small>
                    </div>
                </div>
            </div>

            <!-- Settings Content -->
            <div class="col-md-9">
                @foreach (var group in Model)
                {
                    <div class="card shadow-sm mb-4" id="@group.Group">
                        <div class="card-header bg-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">@group.GroupDisplayName</h5>
                                <a asp-action="Edit" asp-route-group="@group.Group" class="btn btn-primary btn-sm">
                                    <i class="fas fa-edit me-1"></i>Edit All
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 30%">Setting</th>
                                            <th style="width: 40%">Value</th>
                                            <th style="width: 30%">Description</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var setting in group.Settings)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@FormatSettingKey(setting.Key)</strong>
                                                    @if (setting.SettingType == "Color")
                                                    {
                                                        <br><span class="badge" style="background-color: @setting.Value; width: 50px;">&nbsp;</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (setting.SettingType == "Image" && !string.IsNullOrEmpty(setting.Value))
                                                    {
                                                        <img src="@setting.Value" alt="@setting.Key" style="max-width: 100px; max-height: 50px;" class="img-thumbnail">
                                                    }
                                                    else if (setting.SettingType == "Boolean")
                                                    {
                                                        @if (setting.Value?.ToLower() == "true")
                                                        {
                                                            <span class="badge bg-success"><i class="fas fa-check"></i> Enabled</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary"><i class="fas fa-times"></i> Disabled</span>
                                                        }
                                                    }
                                                    else if (setting.SettingType == "Html")
                                                    {
                                                        <span class="text-muted small">[HTML Content]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-truncate d-inline-block" style="max-width: 300px;">
                                                            @(string.IsNullOrEmpty(setting.Value) ? "(Not set)" : setting.Value)
                                                        </span>
                                                    }
                                                </td>
                                                <td>
                                                    <small class="text-muted">@setting.Description</small>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@functions {
    string FormatSettingKey(string key)
    {
        // Convert PascalCase to Title Case with spaces
        return System.Text.RegularExpressions.Regex.Replace(key, "([a-z])([A-Z])", "$1 $2");
    }
}
