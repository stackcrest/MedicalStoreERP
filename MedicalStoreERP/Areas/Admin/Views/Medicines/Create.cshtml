@model MedicineCreateViewModel
@{
    ViewData["Title"] = "Add Medicine";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Add New Medicine</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Medicines</a></li>
                    <li class="breadcrumb-item active">Add</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="Create" method="post">
            <div class="row">
                <div class="col-lg-8">
                    <!-- Basic Info -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-info-circle me-2"></i>Basic Information</h3>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Name" class="form-label">Medicine Name *</label>
                                    <input asp-for="Name" class="form-control" placeholder="Enter medicine name">
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="GenericName" class="form-label">Generic Name *</label>
                                    <input asp-for="GenericName" class="form-control" placeholder="Enter generic name">
                                    <span asp-validation-for="GenericName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CategoryId" class="form-label">Category *</label>
                                    <select asp-for="CategoryId" class="form-select" asp-items="@ViewBag.Categories">
                                        <option value="">Select Category</option>
                                    </select>
                                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Manufacturer" class="form-label">Manufacturer *</label>
                                    <input asp-for="Manufacturer" class="form-control" placeholder="Enter manufacturer">
                                    <span asp-validation-for="Manufacturer" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3" 
                                          placeholder="Enter description"></textarea>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Composition" class="form-label">Composition</label>
                                    <input asp-for="Composition" class="form-control" placeholder="e.g., Paracetamol 500mg">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="Dosage" class="form-label">Dosage</label>
                                    <input asp-for="Dosage" class="form-control" placeholder="e.g., 1 tablet 3 times daily">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="PackSize" class="form-label">Pack Size</label>
                                    <input asp-for="PackSize" class="form-control" placeholder="e.g., 10 tablets">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Stock & Pricing -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-rupee-sign me-2"></i>Stock & Pricing</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="BatchNo" class="form-label">Batch Number *</label>
                                    <input asp-for="BatchNo" class="form-control" placeholder="Enter batch number">
                                    <span asp-validation-for="BatchNo" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="HSNCode" class="form-label">HSN Code</label>
                                    <input asp-for="HSNCode" class="form-control" placeholder="e.g., 3004">
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="PurchasePrice" class="form-label">Purchase Price (₹) *</label>
                                    <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control">
                                    <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="MRP" class="form-label">MRP (₹) *</label>
                                    <input asp-for="MRP" type="number" step="0.01" class="form-control">
                                    <span asp-validation-for="MRP" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="SalePrice" class="form-label">Sale Price (₹) *</label>
                                    <input asp-for="SalePrice" type="number" step="0.01" class="form-control">
                                    <span asp-validation-for="SalePrice" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label asp-for="StockQty" class="form-label">Stock Quantity *</label>
                                    <input asp-for="StockQty" type="number" class="form-control">
                                    <span asp-validation-for="StockQty" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="ReorderLevel" class="form-label">Reorder Level *</label>
                                    <input asp-for="ReorderLevel" type="number" class="form-control">
                                    <span asp-validation-for="ReorderLevel" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="GSTPercent" class="form-label">GST (%) *</label>
                                    <input asp-for="GSTPercent" type="number" step="0.01" class="form-control">
                                    <span asp-validation-for="GSTPercent" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ManufactureDate" class="form-label">Manufacture Date</label>
                                    <input asp-for="ManufactureDate" type="date" class="form-control">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ExpiryDate" class="form-label">Expiry Date *</label>
                                    <input asp-for="ExpiryDate" type="date" class="form-control">
                                    <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Image & Status -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-image me-2"></i>Product Image</h3>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <div class="position-relative d-inline-block" id="imagePreviewContainer">
                                    <div id="imagePlaceholder" class="rounded shadow-sm d-flex align-items-center justify-content-center" style="width: 200px; height: 200px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <div class="text-center text-white">
                                            <i class="fas fa-pills fa-3x mb-2 opacity-75"></i>
                                            <div><small class="opacity-75">No Image</small></div>
                                        </div>
                                    </div>
                                    <img id="imagePreview" src="" class="img-fluid rounded shadow-sm" style="max-height: 200px; min-height: 150px; object-fit: cover; display: none;">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Upload Image</label>
                                <div class="input-group">
                                    <input type="file" class="form-control" id="imageUpload" accept="image/*">
                                    <button type="button" class="btn btn-primary" onclick="uploadMedicineImage()">
                                        <i class="fas fa-upload"></i>
                                    </button>
                                </div>
                                <small class="text-muted">Max 5MB. Allowed: JPG, PNG, GIF, WebP</small>
                            </div>

                            <div class="mb-0">
                                <label asp-for="ImageUrl" class="form-label">Or Enter Image URL</label>
                                <input asp-for="ImageUrl" class="form-control" placeholder="https://..." id="ImageUrl">
                            </div>
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-toggle-on me-2"></i>Status</h3>
                        </div>
                        <div class="card-body">
                            <div class="form-check mb-3">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox">
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                                <br><small class="text-muted">Active medicines will be visible in the store</small>
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="RequiresPrescription" class="form-check-input" type="checkbox">
                                <label asp-for="RequiresPrescription" class="form-check-label">Requires Prescription</label>
                                <br><small class="text-muted">Prescription medicines require doctor's note</small>
                            </div>
                            <div class="form-check">
                                <input asp-for="IsFeatured" class="form-check-input" type="checkbox">
                                <label asp-for="IsFeatured" class="form-check-label">Featured</label>
                                <br><small class="text-muted">Featured medicines appear on homepage</small>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-primary btn-block mb-2">
                                <i class="fas fa-save me-2"></i>Save Medicine
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-block">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Image preview from URL
        $('#ImageUrl').on('input', function() {
            var url = $(this).val();
            if (url) {
                $('#imagePreview').attr('src', url).show();
                $('#imagePlaceholder').hide();
            } else {
                $('#imagePreview').hide();
                $('#imagePlaceholder').show();
            }
        });

        // Upload image file
        function uploadMedicineImage() {
            var fileInput = document.getElementById('imageUpload');
            if (!fileInput.files || !fileInput.files[0]) {
                alert('Please select an image file first');
                return;
            }

            var file = fileInput.files[0];
            var formData = new FormData();
            formData.append('file', file);

            // Show loading state
            var btn = event.target.closest('button');
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            $.ajax({
                url: '/Admin/Medicines/UploadImage',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        $('#ImageUrl').val(response.url);
                        $('#imagePreview').attr('src', response.url).show();
                        $('#imagePlaceholder').hide();
                        fileInput.value = '';
                    } else {
                        alert('Upload failed: ' + response.message);
                    }
                },
                error: function(xhr, status, error) {
                    alert('Upload failed: ' + error);
                },
                complete: function() {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                }
            });
        }

        // Preview selected image before upload
        $('#imageUpload').on('change', function() {
            var file = this.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#imagePreview').attr('src', e.target.result).show();
                    $('#imagePlaceholder').hide();
                };
                reader.readAsDataURL(file);
            }
        });
    </script>
}
