@model PaginatedResult<MedicineViewModel>
@{
    ViewData["Title"] = "Medicines";
}

<!-- Content Header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Medicines</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Medicines</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-filter me-2"></i>Filter Medicines
                </h3>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-3">
                        <input type="text" name="search" class="form-control" placeholder="Search medicines..." 
                               value="@ViewBag.Search">
                    </div>
                    <div class="col-md-2">
                        <select name="categoryId" class="form-select" asp-items="@ViewBag.Categories">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-2">
                            <input type="checkbox" name="lowStock" value="true" class="form-check-input" 
                                   @(ViewBag.LowStock == true ? "checked" : "")>
                            <label class="form-check-label">Low Stock Only</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check mt-2">
                            <input type="checkbox" name="nearExpiry" value="true" class="form-check-input"
                                   @(ViewBag.NearExpiry == true ? "checked" : "")>
                            <label class="form-check-label">Near Expiry Only</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-search me-1"></i>Search
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-redo me-1"></i>Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Medicines Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-pills me-2"></i>Medicine List (@Model.TotalCount items)
                </h3>
                <div class="card-tools">
                    <a asp-action="BulkUpload" class="btn btn-success btn-sm me-2">
                        <i class="fas fa-file-excel me-1"></i>Bulk Upload
                    </a>
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus me-1"></i>Add Medicine
                    </a>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Batch</th>
                            <th>Stock</th>
                            <th>Cost</th>
                            <th>Price</th>
                            <th>Expiry</th>
                            <th>Status</th>
                            <th width="150">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var medicine in Model.Items)
                        {
                            var stockClass = medicine.IsLowStock ? "text-danger fw-bold" : "";
                            var expiryClass = medicine.IsExpired ? "text-danger" : medicine.IsNearExpiry ? "text-warning" : "";
                            <tr>
                                <td>
                                    <strong>@medicine.Name</strong>
                                    <br><small class="text-muted">@medicine.GenericName</small>
                                </td>
                                <td>@medicine.CategoryName</td>
                                <td>@medicine.BatchNo</td>
                                <td class="@stockClass">
                                    @medicine.StockQty
                                    @if (medicine.IsLowStock)
                                    {
                                        <i class="fas fa-exclamation-triangle text-warning ms-1" title="Low Stock"></i>
                                    }
                                </td>
                                <td>₹@medicine.PurchasePrice.ToString("N2")</td>
                                <td>₹@medicine.SalePrice.ToString("N2")</td>
                                <td class="@expiryClass">
                                    @medicine.ExpiryDate.ToString("dd/MM/yyyy")
                                    @if (medicine.IsExpired)
                                    {
                                        <span class="badge bg-danger ms-1">Expired</span>
                                    }
                                    else if (medicine.IsNearExpiry)
                                    {
                                        <span class="badge bg-warning ms-1">Expiring Soon</span>
                                    }
                                </td>
                                <td>
                                    @if (medicine.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="action-btns">
                                    <a asp-action="Details" asp-route-id="@medicine.Id" class="btn btn-info btn-sm" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@medicine.Id" class="btn btn-warning btn-sm" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@medicine.Id" method="post" class="d-inline"
                                          onsubmit="return confirmDelete(this)">
                                        <button type="submit" class="btn btn-danger btn-sm" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer">
                    <nav>
                        <ul class="pagination justify-content-center mb-0">
                            @if (Model.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                                       asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId">@i</a>
                                </li>
                            }
                            @if (Model.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-search="@ViewBag.Search" asp-route-categoryId="@ViewBag.CategoryId">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</section>
