@model ProcessReturnViewModel
@{
    ViewData["Title"] = "Process Refund";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Process Refund</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Returns</a></li>
                    <li class="breadcrumb-item active">Process Refund</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <form asp-action="ProcessRefund" method="post">
                    <input type="hidden" name="ReturnRequestId" value="@Model.ReturnRequestId" />

                    <div class="card">
                        <div class="card-header bg-success text-white">
                            <h3 class="card-title">
                                <i class="fas fa-money-bill-wave me-2"></i>Refund for @Model.ReturnRequest?.ReturnNumber
                            </h3>
                        </div>
                        <div class="card-body">
                            <!-- Return Summary -->
                            <div class="row mb-4">
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Order:</strong> @Model.ReturnRequest?.OrderNumber</p>
                                    <p class="mb-1"><strong>Customer:</strong> @Model.ReturnRequest?.CustomerName</p>
                                    <p class="mb-0"><strong>Email:</strong> @Model.ReturnRequest?.CustomerEmail</p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-1"><strong>Refund Method:</strong> @Model.ReturnRequest?.RefundMethodDisplay</p>
                                    @if (Model.ReturnRequest?.RefundMethod == RefundMethod.BankTransfer)
                                    {
                                        <p class="mb-1"><small>A/C: @Model.ReturnRequest?.BankAccountNumber</small></p>
                                        <p class="mb-0"><small>IFSC: @Model.ReturnRequest?.BankIFSC</small></p>
                                    }
                                    @if (Model.ReturnRequest?.RefundMethod == RefundMethod.UPI)
                                    {
                                        <p class="mb-0"><small>UPI: @Model.ReturnRequest?.UPIId</small></p>
                                    }
                                </div>
                            </div>

                            <hr>

                            <!-- Items Summary -->
                            <h6 class="mb-3">Items Being Refunded</h6>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ReturnRequest?.Items != null)
                                    {
                                        @foreach (var item in Model.ReturnRequest.Items)
                                        {
                                            <tr>
                                                <td>@item.MedicineName</td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">₹@item.TotalPrice.ToString("N2")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <td colspan="2" class="text-end"><strong>Approved Return Amount:</strong></td>
                                        <td class="text-end"><strong>₹@(Model.ReturnRequest?.TotalReturnAmount.ToString("N2") ?? "0.00")</strong></td>
                                    </tr>
                                </tfoot>
                            </table>

                            <hr>

                            <!-- Refund Form -->
                            <div class="mb-3">
                                <label class="form-label"><strong>Actual Refund Amount</strong></label>
                                <div class="input-group">
                                    <span class="input-group-text">₹</span>
                                    <input type="number" step="0.01" class="form-control form-control-lg" 
                                           name="ActualRefundedAmount" 
                                           value="@Model.ReturnRequest?.TotalReturnAmount" 
                                           required>
                                </div>
                                <small class="text-muted">Enter the actual amount being refunded to the customer.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Transaction ID / Reference Number</label>
                                <input type="text" class="form-control" name="RefundTransactionId" 
                                       placeholder="e.g., TXN123456789">
                                <small class="text-muted">Payment reference for tracking purposes.</small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <textarea class="form-control" name="AdminNotes" rows="3" 
                                          placeholder="Any notes about this refund..."></textarea>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success btn-lg flex-fill">
                                    <i class="fas fa-check me-2"></i>Process Refund
                                </button>
                                <a asp-action="Details" asp-route-id="@Model.ReturnRequestId" class="btn btn-outline-secondary btn-lg">
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
