@model ReturnRequestViewModel
@{
    ViewData["Title"] = $"Return {Model.ReturnNumber}";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Return Request Details</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Returns</a></li>
                    <li class="breadcrumb-item active">@Model.ReturnNumber</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- Left Column - Main Info -->
            <div class="col-lg-8">
                <!-- Return Status Card -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-undo-alt me-2"></i>@Model.ReturnNumber
                        </h3>
                        <div class="card-tools">
                            <span class="badge bg-@Model.StatusBadgeClass badge-lg">@Model.StatusDisplay</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Progress Timeline -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="progress-wrapper">
                                    @{
                                        var steps = new[] { 
                                            ("Submitted", Model.CreatedAt, true),
                                            ("Approved", Model.ApprovedAt, Model.Status >= ReturnStatus.Approved && Model.Status != ReturnStatus.Rejected),
                                            ("Items Received", Model.ItemsReceivedAt, Model.Status >= ReturnStatus.ItemsReceived && Model.Status != ReturnStatus.Rejected),
                                            ("Refund Processed", Model.RefundProcessedAt, Model.Status >= ReturnStatus.RefundProcessed && Model.Status != ReturnStatus.Rejected),
                                            ("Completed", Model.CompletedAt, Model.Status == ReturnStatus.Completed)
                                        };
                                        var stepIndex = 0;
                                    }
                                    <div class="d-flex justify-content-between position-relative">
                                        @foreach (var (label, date, isCompleted) in steps)
                                        {
                                            <div class="text-center" style="flex: 1;">
                                                <div class="rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center 
                                                    @(isCompleted ? "bg-success" : "bg-light border")" 
                                                    style="width: 40px; height: 40px;">
                                                    @if (isCompleted)
                                                    {
                                                        <i class="fas fa-check text-white"></i>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">@(++stepIndex)</span>
                                                    }
                                                </div>
                                                <small class="d-block @(isCompleted ? "text-success fw-bold" : "text-muted")">@label</small>
                                                @if (date.HasValue)
                                                {
                                                    <small class="text-muted">@date.Value.ToString("dd MMM, HH:mm")</small>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (Model.Status == ReturnStatus.Rejected)
                        {
                            <div class="alert alert-danger">
                                <i class="fas fa-times-circle me-2"></i>
                                <strong>Return Rejected:</strong> @Model.CancellationReason
                            </div>
                        }

                        @if (Model.Status == ReturnStatus.Cancelled)
                        {
                            <div class="alert alert-secondary">
                                <i class="fas fa-ban me-2"></i>
                                <strong>Return Cancelled:</strong> @(Model.CancellationReason ?? "Cancelled by customer")
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Return Information</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="text-muted">Reason:</td>
                                        <td><span class="badge bg-secondary">@Model.ReasonDisplay</span></td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(Model.ReasonDetails))
                                    {
                                        <tr>
                                            <td class="text-muted">Details:</td>
                                            <td>@Model.ReasonDetails</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td class="text-muted">Refund Method:</td>
                                        <td>@Model.RefundMethodDisplay</td>
                                    </tr>
                                    @if (Model.RefundMethod == RefundMethod.BankTransfer && !string.IsNullOrEmpty(Model.BankAccountNumber))
                                    {
                                        <tr>
                                            <td class="text-muted">Bank Account:</td>
                                            <td>
                                                @Model.BankAccountName<br>
                                                <small>A/C: @Model.BankAccountNumber | IFSC: @Model.BankIFSC</small>
                                            </td>
                                        </tr>
                                    }
                                    @if (Model.RefundMethod == RefundMethod.UPI && !string.IsNullOrEmpty(Model.UPIId))
                                    {
                                        <tr>
                                            <td class="text-muted">UPI ID:</td>
                                            <td>@Model.UPIId</td>
                                        </tr>
                                    }
                                </table>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-muted mb-3">Order Information</h6>
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td class="text-muted">Order Number:</td>
                                        <td>
                                            <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId">
                                                @Model.OrderNumber
                                            </a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Order Date:</td>
                                        <td>@Model.OrderDate.ToString("dd MMM yyyy")</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Order Total:</td>
                                        <td>₹@Model.OrderTotalAmount.ToString("N2")</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Return Items -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-pills me-2"></i>Return Items</h3>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Medicine</th>
                                    <th>Batch</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                    <th>Inventory Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <strong>@item.MedicineName</strong>
                                            @if (!string.IsNullOrEmpty(item.Reason))
                                            {
                                                <br><small class="text-muted">@item.Reason</small>
                                            }
                                        </td>
                                        <td>@item.BatchNo</td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                                        <td class="text-end">₹@item.TotalPrice.ToString("N2")</td>
                                        <td>
                                            @if (item.ReturnedToInventory)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check me-1"></i>@item.ReturnedQuantity returned to stock
                                                </span>
                                                @if (!string.IsNullOrEmpty(item.InventoryNotes))
                                                {
                                                    <br><small class="text-muted">@item.InventoryNotes</small>
                                                }
                                            }
                                            else if (Model.Status >= ReturnStatus.ItemsReceived)
                                            {
                                                <span class="badge bg-warning">Not returned to stock</span>
                                                @if (!item.IsResaleable)
                                                {
                                                    <br><small class="text-danger">@item.ConditionNotes</small>
                                                }
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="4" class="text-end"><strong>Return Total:</strong></td>
                                    <td class="text-end"><strong>₹@Model.TotalReturnAmount.ToString("N2")</strong></td>
                                    <td></td>
                                </tr>
                                @if (Model.RefundedAmount > 0)
                                {
                                    <tr class="text-success">
                                        <td colspan="4" class="text-end"><strong>Refunded:</strong></td>
                                        <td class="text-end"><strong>₹@Model.RefundedAmount.ToString("N2")</strong></td>
                                        <td></td>
                                    </tr>
                                }
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Customer Notes / Images -->
                @if (!string.IsNullOrEmpty(Model.CustomerNotes) || !string.IsNullOrEmpty(Model.ImageUrl1))
                {
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-comment me-2"></i>Customer Notes & Attachments</h3>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(Model.CustomerNotes))
                            {
                                <p>@Model.CustomerNotes</p>
                            }
                            @if (!string.IsNullOrEmpty(Model.ImageUrl1) || !string.IsNullOrEmpty(Model.ImageUrl2) || !string.IsNullOrEmpty(Model.ImageUrl3))
                            {
                                <div class="row">
                                    @foreach (var img in new[] { Model.ImageUrl1, Model.ImageUrl2, Model.ImageUrl3 }.Where(i => !string.IsNullOrEmpty(i)))
                                    {
                                        <div class="col-md-4 mb-3">
                                            <a href="@img" target="_blank">
                                                <img src="@img" class="img-thumbnail" alt="Return Image">
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Right Column - Actions & Customer Info -->
            <div class="col-lg-4">
                <!-- Actions Card -->
                <div class="card">
                    <div class="card-header bg-primary">
                        <h3 class="card-title text-white"><i class="fas fa-tasks me-2"></i>Actions</h3>
                    </div>
                    <div class="card-body">
                        @if (Model.Status == ReturnStatus.Pending)
                        {
                            <form asp-action="Approve" method="post" class="mb-3">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-3">
                                    <label class="form-label">Approved Amount</label>
                                    <div class="input-group">
                                        <span class="input-group-text">₹</span>
                                        <input type="number" step="0.01" class="form-control" name="approvedAmount" 
                                               value="@Model.TotalReturnAmount" required>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Notes</label>
                                    <textarea class="form-control" name="adminNotes" rows="2"></textarea>
                                </div>
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-check me-2"></i>Approve Return
                                </button>
                            </form>
                            <hr>
                            <form asp-action="Reject" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-3">
                                    <label class="form-label">Rejection Reason</label>
                                    <input type="text" class="form-control" name="rejectionReason" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Notes</label>
                                    <textarea class="form-control" name="adminNotes" rows="2"></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="fas fa-times me-2"></i>Reject Return
                                </button>
                            </form>
                        }
                        else if (Model.Status == ReturnStatus.Approved)
                        {
                            <a asp-action="ReceiveItems" asp-route-id="@Model.Id" class="btn btn-primary w-100 mb-2">
                                <i class="fas fa-box me-2"></i>Receive Items & Update Inventory
                            </a>
                            <p class="text-muted small">Mark items as received and decide which can be returned to inventory.</p>
                        }
                        else if (Model.Status == ReturnStatus.ItemsReceived)
                        {
                            <a asp-action="ProcessRefund" asp-route-id="@Model.Id" class="btn btn-success w-100 mb-2">
                                <i class="fas fa-money-bill-wave me-2"></i>Process Refund
                            </a>
                            <p class="text-muted small">Items received. Process the refund to the customer.</p>
                        }
                        else if (Model.Status == ReturnStatus.RefundProcessed)
                        {
                            <form asp-action="Complete" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="mb-3">
                                    <label class="form-label">Completion Notes</label>
                                    <textarea class="form-control" name="adminNotes" rows="2"></textarea>
                                </div>
                                <button type="submit" class="btn btn-success w-100">
                                    <i class="fas fa-check-double me-2"></i>Mark as Completed
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="text-muted text-center">
                                <i class="fas fa-info-circle me-2"></i>
                                @if (Model.Status == ReturnStatus.Completed)
                                {
                                    <span>This return has been completed.</span>
                                }
                                else if (Model.Status == ReturnStatus.Rejected)
                                {
                                    <span>This return has been rejected.</span>
                                }
                                else
                                {
                                    <span>This return has been cancelled.</span>
                                }
                            </p>
                        }
                    </div>
                </div>

                <!-- Customer Info Card -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-user me-2"></i>Customer Information</h3>
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><strong>@Model.CustomerName</strong></p>
                        <p class="mb-1">
                            <i class="fas fa-envelope text-muted me-2"></i>@Model.CustomerEmail
                        </p>
                        @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                        {
                            <p class="mb-0">
                                <i class="fas fa-phone text-muted me-2"></i>@Model.CustomerPhone
                            </p>
                        }
                    </div>
                </div>

                <!-- Admin Notes Card -->
                @if (!string.IsNullOrEmpty(Model.AdminNotes))
                {
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-sticky-note me-2"></i>Admin Notes</h3>
                        </div>
                        <div class="card-body">
                            <p class="mb-0" style="white-space: pre-line;">@Model.AdminNotes</p>
                        </div>
                    </div>
                }

                <!-- Refund Info Card -->
                @if (Model.RefundedAmount > 0)
                {
                    <div class="card bg-success">
                        <div class="card-body text-white">
                            <h5><i class="fas fa-check-circle me-2"></i>Refund Processed</h5>
                            <h3 class="mb-0">₹@Model.RefundedAmount.ToString("N2")</h3>
                            @if (!string.IsNullOrEmpty(Model.RefundTransactionId))
                            {
                                <p class="mb-0 mt-2">
                                    <small>Transaction ID: @Model.RefundTransactionId</small>
                                </p>
                            }
                            @if (Model.RefundProcessedAt.HasValue)
                            {
                                <p class="mb-0">
                                    <small>Processed on @Model.RefundProcessedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</small>
                                </p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
