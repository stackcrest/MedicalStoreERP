@model ReturnListViewModel
@{
    ViewData["Title"] = "Returns Management";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Returns & Refunds</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Returns</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Statistics Cards -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.TotalReturns</h3>
                        <p>Total Returns</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-undo"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.PendingReturns</h3>
                        <p>Pending Review</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-primary">
                    <div class="inner">
                        <h3>@Model.ApprovedReturns</h3>
                        <p>In Progress</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-spinner"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>₹@Model.TotalRefundedAmount.ToString("N0")</h3>
                        <p>Total Refunded</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-rupee-sign"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-filter me-2"></i>Filter Returns</h3>
            </div>
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-3">
                    <div class="col-md-3">
                        <input type="text" name="searchTerm" class="form-control" placeholder="Search return #, order #, customer..." 
                               value="@Model.SearchTerm">
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select" asp-items="@ViewBag.Statuses">
                            <option value="">All Status</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" placeholder="From Date">
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" placeholder="To Date">
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-search me-1"></i>Search
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-redo me-1"></i>Reset
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Returns Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-undo-alt me-2"></i>Return Requests (@Model.Returns.TotalCount)</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Return #</th>
                            <th>Order #</th>
                            <th>Customer</th>
                            <th>Reason</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th width="120">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Returns.Items.Any())
                        {
                            @foreach (var item in Model.Returns.Items)
                            {
                                <tr>
                                    <td><strong>@item.ReturnNumber</strong></td>
                                    <td>
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId">
                                            @item.OrderNumber
                                        </a>
                                    </td>
                                    <td>
                                        <div>@item.CustomerName</div>
                                        <small class="text-muted">@item.CustomerEmail</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.ReasonDisplay</span>
                                    </td>
                                    <td>
                                        <strong>₹@item.TotalReturnAmount.ToString("N2")</strong>
                                        @if (item.RefundedAmount > 0)
                                        {
                                            <br><small class="text-success">Refunded: ₹@item.RefundedAmount.ToString("N2")</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-@item.StatusBadgeClass">@item.StatusDisplay</span>
                                    </td>
                                    <td>
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                        <br><small class="text-muted">@item.CreatedAt.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (item.Status == ReturnStatus.Pending)
                                        {
                                            <button type="button" class="btn btn-sm btn-success" title="Quick Approve"
                                                    onclick="quickApprove(@item.Id, @item.TotalReturnAmount)">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <p class="text-muted mb-0">No return requests found</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.Returns.TotalPages > 1)
            {
                <div class="card-footer">
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center mb-0">
                            @if (Model.Returns.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@(Model.Returns.CurrentPage - 1)"
                                       asp-route-status="@Model.StatusFilter"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">
                                        Previous
                                    </a>
                                </li>
                            }
                            @for (int i = 1; i <= Model.Returns.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Returns.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@i"
                                       asp-route-status="@Model.StatusFilter"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">
                                        @i
                                    </a>
                                </li>
                            }
                            @if (Model.Returns.CurrentPage < Model.Returns.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-page="@(Model.Returns.CurrentPage + 1)"
                                       asp-route-status="@Model.StatusFilter"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">
                                        Next
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</section>

<!-- Quick Approve Modal -->
<div class="modal fade" id="quickApproveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Approve" method="post">
                <input type="hidden" id="approveReturnId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title">Approve Return Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Approved Refund Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" step="0.01" class="form-control" id="approvedAmount" name="approvedAmount" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Admin Notes (Optional)</label>
                        <textarea class="form-control" name="adminNotes" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Approve Return</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickApprove(returnId, amount) {
            document.getElementById('approveReturnId').value = returnId;
            document.getElementById('approvedAmount').value = amount.toFixed(2);
            var modal = new bootstrap.Modal(document.getElementById('quickApproveModal'));
            modal.show();
        }
    </script>
}
