@model StockReportViewModel
@{
    ViewData["Title"] = "Expiry Report";
    var daysThreshold = ViewBag.DaysThreshold ?? 30;
    var expiredItems = Model.Items.Where(i => i.DaysToExpiry < 0).ToList();
    var expiringItems = Model.Items.Where(i => i.DaysToExpiry >= 0 && i.DaysToExpiry <= daysThreshold).ToList();
    var safeItems = Model.Items.Where(i => i.DaysToExpiry > daysThreshold).ToList();
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Expiry Report</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Expiry Report</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-filter me-2"></i>Filter Options</h3>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Days to Expiry Threshold</label>
                        <select name="daysThreshold" class="form-select">
                            <option value="30" selected="@(daysThreshold == 30)">30 Days</option>
                            <option value="60" selected="@(daysThreshold == 60)">60 Days</option>
                            <option value="90" selected="@(daysThreshold == 90)">90 Days</option>
                            <option value="180" selected="@(daysThreshold == 180)">180 Days</option>
                            <option value="365" selected="@(daysThreshold == 365)">1 Year</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-2"></i>Generate
                        </button>
                        <a asp-action="ExportExpiry" asp-route-daysThreshold="@daysThreshold" class="btn btn-success">
                            <i class="fas fa-file-excel me-2"></i>Export
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@expiredItems.Count</h3>
                        <p>Expired Items</p>
                    </div>
                    <div class="icon"><i class="fas fa-times-circle"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@expiringItems.Count</h3>
                        <p>Expiring in @daysThreshold Days</p>
                    </div>
                    <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@safeItems.Count</h3>
                        <p>Safe Items</p>
                    </div>
                    <div class="icon"><i class="fas fa-check-circle"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>₹@((expiredItems.Sum(i => i.StockValue) + expiringItems.Sum(i => i.StockValue)).ToString("N0"))</h3>
                        <p>Value at Risk</p>
                    </div>
                    <div class="icon"><i class="fas fa-rupee-sign"></i></div>
                </div>
            </div>
        </div>

        <!-- Expired Items -->
        @if (expiredItems.Any())
        {
            <div class="card card-danger">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-times-circle me-2"></i>Expired Items (@expiredItems.Count)</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body table-responsive p-0">
                    <table class="table table-hover table-striped">
                        <thead class="table-danger">
                            <tr>
                                <th>Medicine</th>
                                <th>Category</th>
                                <th>Batch No</th>
                                <th class="text-center">Stock Qty</th>
                                <th class="text-end">Stock Value</th>
                                <th class="text-center">Expiry Date</th>
                                <th class="text-center">Days Expired</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in expiredItems.OrderBy(i => i.DaysToExpiry))
                            {
                                <tr>
                                    <td><strong>@item.MedicineName</strong></td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.BatchNo</td>
                                    <td class="text-center">@item.StockQty</td>
                                    <td class="text-end">₹@item.StockValue.ToString("N2")</td>
                                    <td class="text-center">@item.ExpiryDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge bg-danger">@Math.Abs(item.DaysToExpiry) days ago</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3"><strong>Total Expired</strong></td>
                                <td class="text-center"><strong>@expiredItems.Sum(i => i.StockQty)</strong></td>
                                <td class="text-end"><strong>₹@expiredItems.Sum(i => i.StockValue).ToString("N2")</strong></td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

        <!-- Expiring Soon Items -->
        @if (expiringItems.Any())
        {
            <div class="card card-warning">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-exclamation-triangle me-2"></i>Expiring Soon (@expiringItems.Count)</h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body table-responsive p-0">
                    <table class="table table-hover table-striped">
                        <thead class="table-warning">
                            <tr>
                                <th>Medicine</th>
                                <th>Category</th>
                                <th>Batch No</th>
                                <th class="text-center">Stock Qty</th>
                                <th class="text-end">Stock Value</th>
                                <th class="text-center">Expiry Date</th>
                                <th class="text-center">Days Remaining</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in expiringItems.OrderBy(i => i.DaysToExpiry))
                            {
                                <tr>
                                    <td><strong>@item.MedicineName</strong></td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.BatchNo</td>
                                    <td class="text-center">@item.StockQty</td>
                                    <td class="text-end">₹@item.StockValue.ToString("N2")</td>
                                    <td class="text-center">@item.ExpiryDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">
                                        @if (item.DaysToExpiry <= 7)
                                        {
                                            <span class="badge bg-danger">@item.DaysToExpiry days</span>
                                        }
                                        else if (item.DaysToExpiry <= 15)
                                        {
                                            <span class="badge bg-warning text-dark">@item.DaysToExpiry days</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">@item.DaysToExpiry days</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3"><strong>Total Expiring</strong></td>
                                <td class="text-center"><strong>@expiringItems.Sum(i => i.StockQty)</strong></td>
                                <td class="text-end"><strong>₹@expiringItems.Sum(i => i.StockValue).ToString("N2")</strong></td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        }

        <!-- All Items Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-list me-2"></i>All Items by Expiry Date</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover table-striped" id="expiryTable">
                    <thead class="table-light">
                        <tr>
                            <th>Medicine</th>
                            <th>Category</th>
                            <th>Batch No</th>
                            <th class="text-center">Stock Qty</th>
                            <th class="text-end">Purchase Price</th>
                            <th class="text-end">Sale Price</th>
                            <th class="text-end">Stock Value</th>
                            <th class="text-center">Expiry Date</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items.OrderBy(i => i.ExpiryDate))
                        {
                            var rowClass = item.DaysToExpiry < 0 ? "table-danger" : 
                                          (item.DaysToExpiry <= daysThreshold ? "table-warning" : "");
                            <tr class="@rowClass">
                                <td><strong>@item.MedicineName</strong></td>
                                <td>@item.CategoryName</td>
                                <td>@item.BatchNo</td>
                                <td class="text-center">@item.StockQty</td>
                                <td class="text-end">₹@item.PurchasePrice.ToString("N2")</td>
                                <td class="text-end">₹@item.SalePrice.ToString("N2")</td>
                                <td class="text-end">₹@item.StockValue.ToString("N2")</td>
                                <td class="text-center">@item.ExpiryDate.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    @if (item.DaysToExpiry < 0)
                                    {
                                        <span class="badge bg-danger">Expired</span>
                                    }
                                    else if (item.DaysToExpiry <= 7)
                                    {
                                        <span class="badge bg-danger">@item.DaysToExpiry days</span>
                                    }
                                    else if (item.DaysToExpiry <= 30)
                                    {
                                        <span class="badge bg-warning text-dark">@item.DaysToExpiry days</span>
                                    }
                                    else if (item.DaysToExpiry <= daysThreshold)
                                    {
                                        <span class="badge bg-info">@item.DaysToExpiry days</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Safe</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-primary">
                        <tr>
                            <td colspan="3"><strong>Grand Total</strong></td>
                            <td class="text-center"><strong>@Model.Items.Sum(i => i.StockQty)</strong></td>
                            <td colspan="2"></td>
                            <td class="text-end"><strong>₹@Model.TotalStockValue.ToString("N2")</strong></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No items found matching the selected criteria.
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#expiryTable').DataTable({
                order: [[7, 'asc']],
                pageLength: 25
            });
        });
    </script>
}
