@model ExpiryReportViewModel
@{
    ViewData["Title"] = "Expiry Report";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Expiry Report</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Expiry Report</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Filter Card -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-filter me-2"></i>Filter Options</h3>
            </div>
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Expiry Period</label>
                        <select name="months" class="form-select">
                            <option value="1" selected="@(Model.MonthsAhead == 1)">Within 1 Month</option>
                            <option value="3" selected="@(Model.MonthsAhead == 3)">Within 3 Months</option>
                            <option value="6" selected="@(Model.MonthsAhead == 6)">Within 6 Months</option>
                            <option value="12" selected="@(Model.MonthsAhead == 12)">Within 1 Year</option>
                            <option value="0" selected="@(Model.MonthsAhead == 0)">Already Expired</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Category</label>
                        <select name="categoryId" class="form-select" asp-items="@ViewBag.Categories">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Supplier</label>
                        <select name="supplierId" class="form-select" asp-items="@ViewBag.Suppliers">
                            <option value="">All Suppliers</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-2"></i>Generate
                        </button>
                        <a asp-action="ExportExpiry" asp-route-months="@Model.MonthsAhead" class="btn btn-success">
                            <i class="fas fa-file-excel me-2"></i>Export
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@Model.ExpiredCount</h3>
                        <p>Already Expired</p>
                    </div>
                    <div class="icon"><i class="fas fa-times-circle"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@Model.ExpiringThisMonth</h3>
                        <p>Expiring This Month</p>
                    </div>
                    <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.ExpiringIn3Months</h3>
                        <p>Expiring in 3 Months</p>
                    </div>
                    <div class="icon"><i class="fas fa-clock"></i></div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-secondary">
                    <div class="inner">
                        <h3>₹@Model.TotalExpiryValue.ToString("N0")</h3>
                        <p>Total Expiry Value</p>
                    </div>
                    <div class="icon"><i class="fas fa-rupee-sign"></i></div>
                </div>
            </div>
        </div>

        <!-- Expiry Timeline -->
        <div class="row">
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-chart-bar me-2"></i>Expiry Timeline</h3>
                    </div>
                    <div class="card-body">
                        <canvas id="timelineChart" height="200"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-chart-pie me-2"></i>Expiry by Category</h3>
                    </div>
                    <div class="card-body">
                        <canvas id="categoryChart" height="200"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Expiry Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-calendar-times me-2"></i>Expiring/Expired Items</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-striped" id="expiryTable">
                    <thead>
                        <tr>
                            <th>Medicine</th>
                            <th>Category</th>
                            <th>Batch #</th>
                            <th class="text-center">Stock</th>
                            <th class="text-end">Cost Price</th>
                            <th class="text-end">Value at Risk</th>
                            <th>Expiry Date</th>
                            <th>Days Left</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items?.Any() == true)
                        {
                            @foreach (var item in Model.Items.OrderBy(i => i.ExpiryDate))
                            {
                                var daysLeft = (item.ExpiryDate - DateTime.Today).Days;
                                var isExpired = daysLeft < 0;
                                var isUrgent = daysLeft <= 30 && daysLeft >= 0;
                                var isWarning = daysLeft <= 90 && daysLeft > 30;
                                
                                <tr class="@(isExpired ? "table-danger" : isUrgent ? "table-warning" : "")">
                                    <td>
                                        <strong>@item.Name</strong><br>
                                        <small class="text-muted">@item.GenericName</small>
                                    </td>
                                    <td>@item.CategoryName</td>
                                    <td><code>@item.BatchNumber</code></td>
                                    <td class="text-center"><strong>@item.StockQuantity</strong></td>
                                    <td class="text-end">₹@item.CostPrice.ToString("N2")</td>
                                    <td class="text-end"><strong class="text-danger">₹@item.ValueAtRisk.ToString("N2")</strong></td>
                                    <td>@item.ExpiryDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (isExpired)
                                        {
                                            <span class="text-danger"><strong>@Math.Abs(daysLeft) days ago</strong></span>
                                        }
                                        else
                                        {
                                            <span class="@(isUrgent ? "text-warning" : isWarning ? "text-info" : "")">
                                                <strong>@daysLeft days</strong>
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (isExpired)
                                        {
                                            <span class="badge bg-danger">Expired</span>
                                        }
                                        else if (isUrgent)
                                        {
                                            <span class="badge bg-warning text-dark">Critical</span>
                                        }
                                        else if (isWarning)
                                        {
                                            <span class="badge bg-info">Warning</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Monitor</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="fas fa-check-circle fa-3x mb-3 text-success d-block"></i>
                                    No items expiring in the selected period
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recommendations -->
        @if (Model.Items?.Any() == true)
        {
            <div class="card bg-light">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-lightbulb me-2"></i>Recommendations</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="alert alert-danger mb-0">
                                <h6><i class="fas fa-exclamation-circle me-2"></i>Immediate Action Required</h6>
                                <p class="small mb-0">
                                    @Model.ExpiredCount items have already expired. Consider returning to supplier or disposing properly.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="alert alert-warning mb-0">
                                <h6><i class="fas fa-clock me-2"></i>Run Clearance Sale</h6>
                                <p class="small mb-0">
                                    @Model.ExpiringThisMonth items expiring this month. Offer discounts to clear stock.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="alert alert-info mb-0">
                                <h6><i class="fas fa-chart-line me-2"></i>Review Purchase Patterns</h6>
                                <p class="small mb-0">
                                    Total value at risk: ₹@Model.TotalExpiryValue.ToString("N2"). Adjust future orders.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Timeline Chart
        var timelineCtx = document.getElementById('timelineChart').getContext('2d');
        new Chart(timelineCtx, {
            type: 'bar',
            data: {
                labels: ['Expired', 'This Month', '1-3 Months', '3-6 Months', '6-12 Months'],
                datasets: [{
                    label: 'Items',
                    data: [@Model.ExpiredCount, @Model.ExpiringThisMonth, @Model.ExpiringIn3Months, @Model.ExpiringIn6Months, @Model.ExpiringIn12Months],
                    backgroundColor: ['#dc3545', '#ffc107', '#17a2b8', '#28a745', '#6c757d']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Category Chart
        var catCtx = document.getElementById('categoryChart').getContext('2d');
        new Chart(catCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(Json.Serialize(Model.CategoryBreakdown?.Select(c => c.CategoryName))),
                datasets: [{
                    data: @Html.Raw(Json.Serialize(Model.CategoryBreakdown?.Select(c => c.Count))),
                    backgroundColor: ['#dc3545', '#ffc107', '#17a2b8', '#28a745', '#6c757d', '#007bff', '#6f42c1']
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'right' } }
            }
        });

        // Initialize DataTable
        $(document).ready(function() {
            $('#expiryTable').DataTable({
                order: [[6, 'asc']],
                pageLength: 50
            });
        });
    </script>
}
