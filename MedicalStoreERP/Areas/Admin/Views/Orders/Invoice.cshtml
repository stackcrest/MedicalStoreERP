@model OrderViewModel
@inject MedicalStoreERP.Services.IAppSettingsService AppSettings
@{
    ViewData["Title"] = "Invoice";
    Layout = null; // No layout for print-friendly invoice
    var settings = AppSettings.GetCachedSettings();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - @Model.OrderNumber</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fff;
            color: #333;
        }
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 30px;
        }
        .invoice-header {
            border-bottom: 3px solid #0d6efd;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        .company-name {
            color: #0d6efd;
            font-size: 28px;
            font-weight: bold;
        }
        .invoice-title {
            font-size: 24px;
            color: #333;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .invoice-details {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
        .table thead th {
            background: #0d6efd;
            color: white;
            font-weight: 500;
            border: none;
        }
        .table tbody td {
            vertical-align: middle;
        }
        .total-section {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
        }
        .grand-total {
            font-size: 20px;
            color: #0d6efd;
            font-weight: bold;
        }
        .footer-note {
            border-top: 1px solid #dee2e6;
            padding-top: 20px;
            margin-top: 30px;
            text-align: center;
            color: #6c757d;
            font-size: 14px;
        }
        @@media print {
            body {
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }
            .no-print {
                display: none !important;
            }
            .invoice-container {
                padding: 0;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Print Button -->
        <div class="no-print mb-4">
            <button onclick="window.print()" class="btn btn-primary me-2">
                <i class="fas fa-print me-2"></i>Print Invoice
            </button>
            <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Back to Order
            </a>
        </div>

        <!-- Invoice Header -->
        <div class="invoice-header">
            <div class="row">
                <div class="col-6">
                    <div class="company-name">@settings.AppName</div>
                    <div class="text-muted">
                        @settings.ContactAddress<br>
                        @settings.ContactCity, @settings.ContactState - @settings.ContactPinCode<br>
                        @if (!string.IsNullOrEmpty(settings.GSTIN))
                        {
                            <text>GSTIN: @settings.GSTIN<br></text>
                        }
                        Phone: @settings.ContactPhone
                    </div>
                </div>
                <div class="col-6 text-end">
                    <div class="invoice-title">Tax Invoice</div>
                    <div class="mt-2">
                        <strong>Invoice No:</strong> @Model.OrderNumber<br>
                        <strong>Date:</strong> @Model.OrderDate.ToString("dd MMM yyyy")<br>
                        <strong>Status:</strong> 
                        <span class="badge @(Model.Status == OrderStatus.Delivered ? "bg-success" : Model.Status == OrderStatus.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                            @Model.Status
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer & Shipping Details -->
        <div class="row mb-4">
            <div class="col-6">
                <div class="invoice-details">
                    <h6 class="text-muted mb-2">BILL TO</h6>
                    <strong>@Model.CustomerName</strong><br>
                    @Model.CustomerEmail<br>
                    @Model.CustomerPhone
                </div>
            </div>
            <div class="col-6">
                <div class="invoice-details">
                    <h6 class="text-muted mb-2">SHIP TO</h6>
                    <strong>@Model.CustomerName</strong><br>
                    @Model.DeliveryAddress<br>
                    @Model.City, @Model.State - @Model.PinCode
                </div>
            </div>
        </div>

        <!-- Order Items Table -->
        <table class="table table-bordered mb-4">
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 35%;">Item Description</th>
                    <th class="text-center" style="width: 10%;">HSN</th>
                    <th class="text-center" style="width: 10%;">Qty</th>
                    <th class="text-end" style="width: 12%;">Rate</th>
                    <th class="text-center" style="width: 10%;">GST %</th>
                    <th class="text-end" style="width: 18%;">Amount</th>
                </tr>
            </thead>
            <tbody>
                @{ var index = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@index</td>
                        <td>
                            <strong>@item.MedicineName</strong><br>
                            <small class="text-muted">Batch: @item.BatchNo</small>
                        </td>
                        <td class="text-center">@item.HSNCode</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                        <td class="text-center">@item.GSTPercent%</td>
                        <td class="text-end">₹@item.TotalPrice.ToString("N2")</td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>

        <!-- Totals Section -->
        <div class="row">
            <div class="col-6">
                <div class="invoice-details">
                    <h6 class="text-muted mb-2">PAYMENT INFORMATION</h6>
                    <strong>Method:</strong> 
                    @(Model.PaymentMethod == PaymentMethod.COD ? "Cash on Delivery" : "Online Payment")<br>
                    <strong>Status:</strong> 
                    <span class="badge @(Model.PaymentStatus == PaymentStatus.Completed ? "bg-success" : "bg-warning text-dark")">
                        @Model.PaymentStatus
                    </span>
                    @if (!string.IsNullOrEmpty(Model.TransactionId))
                    {
                        <br><strong>Transaction ID:</strong> @Model.TransactionId
                    }
                </div>
            </div>
            <div class="col-6">
                <div class="total-section">
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td>Subtotal</td>
                            <td class="text-end">₹@Model.SubTotal.ToString("N2")</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr class="text-success">
                                <td>Discount</td>
                                <td class="text-end">-₹@Model.DiscountAmount.ToString("N2")</td>
                            </tr>
                        }
                        <tr>
                            <td>CGST</td>
                            <td class="text-end">₹@Model.CGSTAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>SGST</td>
                            <td class="text-end">₹@Model.SGSTAmount.ToString("N2")</td>
                        </tr>
                        @if (Model.ShippingCharges > 0)
                        {
                            <tr>
                                <td>Shipping</td>
                                <td class="text-end">₹@Model.ShippingCharges.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="border-top">
                            <td class="grand-total">Grand Total</td>
                            <td class="text-end grand-total">₹@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- GST Summary -->
        <div class="mt-4">
            <h6 class="text-muted">GST SUMMARY</h6>
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Tax Type</th>
                        <th class="text-end">Taxable Amount</th>
                        <th class="text-end">Tax Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>CGST</td>
                        <td class="text-end">₹@Model.SubTotal.ToString("N2")</td>
                        <td class="text-end">₹@Model.CGSTAmount.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td>SGST</td>
                        <td class="text-end">₹@Model.SubTotal.ToString("N2")</td>
                        <td class="text-end">₹@Model.SGSTAmount.ToString("N2")</td>
                    </tr>
                    <tr class="table-light fw-bold">
                        <td>Total GST</td>
                        <td class="text-end">-</td>
                        <td class="text-end">₹@Model.TotalGSTAmount.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="footer-note">
            <p class="mb-1"><strong>Thank you for your business!</strong></p>
            <p class="mb-0">This is a computer-generated invoice and does not require a signature.</p>
            <p class="mb-0 mt-2">For queries, contact us at @settings.ContactEmail | @settings.ContactPhone</p>
        </div>
    </div>

    <script src="https://kit.fontawesome.com/your-kit-id.js" crossorigin="anonymous"></script>
</body>
</html>
