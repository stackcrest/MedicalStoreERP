@model OrderViewModel
@{
    ViewData["Title"] = "Order Details";
    var statusClass = Model.Status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Processing => "bg-info",
        OrderStatus.Shipped => "bg-primary",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Order #@Model.OrderNumber</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
                    <li class="breadcrumb-item active">@Model.OrderNumber</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-8">
                <!-- Order Items -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-shopping-basket me-2"></i>Order Items</h3>
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="https://via.placeholder.com/50" 
                                                     class="rounded me-3" width="50" height="50" style="object-fit: cover;">
                                                <div>
                                                    <strong>@item.MedicineName</strong>
                                                    <br><small class="text-muted">Batch: @item.BatchNo</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                                        <td class="text-end"><strong>₹@item.TotalPrice.ToString("N2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <td colspan="3" class="text-end">Subtotal</td>
                                    <td class="text-end">₹@Model.SubTotal.ToString("N2")</td>
                                </tr>
                                @if (Model.DiscountAmount > 0)
                                {
                                    <tr class="text-success">
                                        <td colspan="3" class="text-end">Discount</td>
                                        <td class="text-end">-₹@Model.DiscountAmount.ToString("N2")</td>
                                    </tr>
                                }
                                <tr>
                                    <td colspan="3" class="text-end">GST</td>
                                    <td class="text-end">₹@Model.TotalGSTAmount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td colspan="3" class="text-end"><strong class="fs-5">Total</strong></td>
                                    <td class="text-end"><strong class="fs-5 text-primary">₹@Model.TotalAmount.ToString("N2")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Prescription Section -->
                @if (Model.RequiresPrescription)
                {
                    <div class="card @(Model.PrescriptionVerified ? "border-success" : "border-warning")">
                        <div class="card-header @(Model.PrescriptionVerified ? "bg-success text-white" : "bg-warning text-dark")">
                            <h3 class="card-title mb-0">
                                <i class="fas fa-file-medical me-2"></i>Prescription
                                @if (Model.PrescriptionVerified)
                                {
                                    <span class="badge bg-white text-success ms-2">Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-white text-warning ms-2">Pending Verification</span>
                                }
                            </h3>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(Model.PrescriptionUrl))
                            {
                                <div class="mb-3">
                                    <strong>Uploaded File:</strong> @Model.PrescriptionFileName
                                </div>
                                <div class="mb-3">
                                    @if (Model.PrescriptionUrl.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@Model.PrescriptionUrl" target="_blank" class="btn btn-primary">
                                            <i class="fas fa-file-pdf me-2"></i>View Prescription PDF
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Model.PrescriptionUrl" target="_blank" class="btn btn-primary mb-2">
                                            <i class="fas fa-external-link-alt me-2"></i>Open Full Size
                                        </a>
                                        <div class="border rounded p-2 bg-light">
                                            <img src="@Model.PrescriptionUrl" alt="Prescription" class="img-fluid" style="max-height: 400px;">
                                        </div>
                                    }
                                </div>
                                
                                @if (Model.PrescriptionVerified)
                                {
                                    <div class="alert alert-success mb-0">
                                        <i class="fas fa-check-circle me-2"></i>
                                        <strong>Verified</strong> on @Model.PrescriptionVerifiedAt?.ToString("dd MMM yyyy, hh:mm tt")
                                        @if (!string.IsNullOrEmpty(Model.PrescriptionVerifiedByName))
                                        {
                                            <span>by @Model.PrescriptionVerifiedByName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(Model.PrescriptionNotes))
                                        {
                                            <br><small>Notes: @Model.PrescriptionNotes</small>
                                        }
                                    </div>
                                }
                                else if (Model.Status != OrderStatus.Cancelled)
                                {
                                    <hr>
                                    <h6>Verify Prescription</h6>
                                    <form asp-action="VerifyPrescription" asp-route-id="@Model.Id" method="post">
                                        <div class="mb-3">
                                            <label class="form-label">Notes (optional)</label>
                                            <textarea name="notes" class="form-control" rows="2" 
                                                      placeholder="Add verification notes..."></textarea>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" name="approve" value="true" class="btn btn-success">
                                                <i class="fas fa-check me-2"></i>Approve Prescription
                                            </button>
                                            <button type="submit" name="approve" value="false" class="btn btn-danger"
                                                    onclick="return confirm('Rejecting prescription will cancel the order. Continue?')">
                                                <i class="fas fa-times me-2"></i>Reject & Cancel Order
                                            </button>
                                        </div>
                                    </form>
                                }
                            }
                            else
                            {
                                <div class="alert alert-danger mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    No prescription uploaded for this order!
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Status Update -->
                @if (Model.Status != OrderStatus.Delivered && Model.Status != OrderStatus.Cancelled)
                {
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-cog me-2"></i>Update Status</h3>
                        </div>
                        <div class="card-body">
                            <div class="btn-group" role="group">
                                @if (Model.Status == OrderStatus.Pending)
                                {
                                    <form asp-action="ProcessOrder" asp-route-id="@Model.Id" method="post" class="me-2">
                                        <button type="submit" class="btn btn-info">
                                            <i class="fas fa-cog me-2"></i>Process Order
                                        </button>
                                    </form>
                                }
                                @if (Model.Status == OrderStatus.Processing)
                                {
                                    <form asp-action="ShipOrder" asp-route-id="@Model.Id" method="post" class="me-2">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-truck me-2"></i>Mark as Shipped
                                        </button>
                                    </form>
                                }
                                @if (Model.Status == OrderStatus.Shipped)
                                {
                                    <form asp-action="DeliverOrder" asp-route-id="@Model.Id" method="post" class="me-2">
                                        <button type="submit" class="btn btn-success">
                                            <i class="fas fa-check me-2"></i>Mark as Delivered
                                        </button>
                                    </form>
                                }
                                @if (Model.Status != OrderStatus.Cancelled)
                                {
                                    <form asp-action="CancelOrder" asp-route-id="@Model.Id" method="post" 
                                          onsubmit="return confirm('Are you sure you want to cancel this order?')">
                                        <button type="submit" class="btn btn-danger">
                                            <i class="fas fa-times me-2"></i>Cancel Order
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                <!-- Order Status -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-info-circle me-2"></i>Order Status</h3>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <span class="badge @statusClass fs-6 px-4 py-2">@Model.Status</span>
                        </div>
                        <table class="table table-sm table-borderless">
                            <tr>
                                <td class="text-muted">Order Date</td>
                                <td class="text-end">@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Payment</td>
                                <td class="text-end">
                                    @if (Model.PaymentMethod == PaymentMethod.COD)
                                    {
                                        <span class="badge bg-secondary">Cash on Delivery</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Online - Paid</span>
                                    }
                                </td>
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.TransactionId))
                            {
                                <tr>
                                    <td class="text-muted">Transaction ID</td>
                                    <td class="text-end">@Model.TransactionId</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <!-- Customer Info -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-user me-2"></i>Customer</h3>
                    </div>
                    <div class="card-body">
                        <h6>@Model.CustomerName</h6>
                        <p class="mb-1 small"><i class="fas fa-envelope me-2 text-muted"></i>@Model.CustomerEmail</p>
                        <p class="mb-0 small"><i class="fas fa-phone me-2 text-muted"></i>@Model.CustomerPhone</p>
                    </div>
                </div>

                <!-- Shipping Address -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-map-marker-alt me-2"></i>Shipping Address</h3>
                    </div>
                    <div class="card-body">
                        <address class="mb-0">
                            @Model.DeliveryAddress<br>
                            @Model.City, @Model.State<br>
                            @Model.PinCode
                        </address>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card">
                    <div class="card-body">
                        <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 mb-2">
                            <i class="fas fa-file-invoice me-2"></i>View Invoice
                        </a>
                        <a asp-action="DownloadInvoice" asp-route-id="@Model.Id" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-download me-2"></i>Download PDF
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
