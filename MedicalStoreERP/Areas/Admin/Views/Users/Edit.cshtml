@model MedicalStoreERP.Areas.Admin.Controllers.UserEditViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Edit User</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                    <li class="breadcrumb-item active">Edit</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-8">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id">
                    
                    <!-- User Information -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-user me-2"></i>User Information</h3>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FullName" class="form-label">Full Name *</label>
                                    <input asp-for="FullName" class="form-control" required>
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label">Email *</label>
                                    <input asp-for="Email" type="email" class="form-control" required>
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control">
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email Verified</label>
                                    <div class="form-control bg-light">
                                        @if (Model.EmailConfirmed)
                                        {
                                            <span class="text-success"><i class="fas fa-check-circle me-1"></i>Verified</span>
                                        }
                                        else
                                        {
                                            <span class="text-warning"><i class="fas fa-exclamation-circle me-1"></i>Not Verified</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label">Address</label>
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Roles & Status -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-user-shield me-2"></i>Roles & Status</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Roles *</label>
                                    <div class="form-check">
                                        @foreach (var role in Model.AvailableRoles)
                                        {
                                            <div class="form-check">
                                                <input type="checkbox" class="form-check-input" name="SelectedRoles" value="@role"
                                                       id="role_@role" @(Model.SelectedRoles.Contains(role) ? "checked" : "")>
                                                <label class="form-check-label" for="role_@role">@role</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Account Status</label>
                                    <div class="form-check form-switch">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox">
                                        <label asp-for="IsActive" class="form-check-label">Active Account</label>
                                    </div>
                                    <small class="text-muted">Inactive users cannot login</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Password Reset -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-key me-2"></i>Password Reset</h3>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="NewPassword" class="form-label">New Password</label>
                                    <input asp-for="NewPassword" type="password" class="form-control" 
                                           placeholder="Leave blank to keep current">
                                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                                    <small class="text-muted">Min 6 characters, include uppercase, lowercase, number</small>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control">
                                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save me-2"></i>Update User
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-lg-4">
                <!-- User Card -->
                <div class="card card-primary card-outline">
                    <div class="card-body box-profile">
                        <div class="text-center">
                            <div class="avatar bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width: 80px; height: 80px; font-size: 2rem;">
                                @Model.FullName.Substring(0, 1).ToUpper()
                            </div>
                            <h3 class="profile-username">@Model.FullName</h3>
                            <p class="text-muted">@Model.Email</p>
                        </div>

                        <ul class="list-group list-group-unbordered mb-3">
                            <li class="list-group-item">
                                <b>User ID</b>
                                <span class="float-end"><code>@Model.Id.Substring(0, 8)...</code></span>
                            </li>
                            <li class="list-group-item">
                                <b>Registered</b>
                                <span class="float-end">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
                            </li>
                            <li class="list-group-item">
                                <b>Last Login</b>
                                <span class="float-end">@(Model.LastLoginAt?.ToString("dd MMM yyyy") ?? "Never")</span>
                            </li>
                            <li class="list-group-item">
                                <b>Total Orders</b>
                                <span class="float-end">@Model.OrderCount</span>
                            </li>
                        </ul>

                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info w-100">
                            <i class="fas fa-eye me-2"></i>View Full Profile
                        </a>
                    </div>
                </div>

                <!-- Activity Log -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-history me-2"></i>Recent Activity</h3>
                    </div>
                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush">
                            @if (Model.RecentOrders?.Any() == true)
                            {
                                @foreach (var order in Model.RecentOrders.Take(5))
                                {
                                    <li class="list-group-item">
                                        <small>
                                            <i class="fas fa-shopping-cart text-muted me-2"></i>
                                            Order <strong>@order.OrderNumber</strong><br>
                                            <span class="text-muted">@order.OrderDate.ToString("dd MMM yyyy")</span>
                                            <span class="float-end">₹@order.TotalAmount.ToString("N0")</span>
                                        </small>
                                    </li>
                                }
                            }
                            else
                            {
                                <li class="list-group-item text-center text-muted py-3">
                                    No recent activity
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
