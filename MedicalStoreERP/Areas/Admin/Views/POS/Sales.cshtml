@model OfflineSaleListViewModel
@{
    ViewData["Title"] = "Offline Sales";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0"><i class="fas fa-receipt me-2"></i>Offline Sales</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item active">Offline Sales</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>₹@Model.TotalRevenue.ToString("N0")</h3>
                        <p>Total Revenue</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-rupee-sign"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@Model.TotalSales</h3>
                        <p>Total Sales</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-shopping-cart"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@(Model.TotalSales > 0 ? (Model.TotalRevenue / Model.TotalSales).ToString("N2") : "0")</h3>
                        <p>Avg. Sale Value</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <a asp-action="Index" class="small-box bg-primary">
                    <div class="inner">
                        <h3><i class="fas fa-plus"></i></h3>
                        <p>New Sale</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-cash-register"></i>
                    </div>
                </a>
            </div>
        </div>

        <!-- Filters -->
        <div class="card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">From Date</label>
                        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">To Date</label>
                        <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-filter me-2"></i>Filter
                        </button>
                        <a asp-action="Sales" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Clear
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Sales Table -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Sales History</h3>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Date & Time</th>
                            <th>Customer</th>
                            <th class="text-end">Subtotal</th>
                            <th class="text-end">GST</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Total</th>
                            <th>Payment</th>
                            <th>Cashier</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Sales.Any())
                        {
                            @foreach (var sale in Model.Sales)
                            {
                                <tr>
                                    <td><strong>@sale.InvoiceNumber</strong></td>
                                    <td>
                                        @sale.SaleDate.ToString("dd MMM yyyy")<br>
                                        <small class="text-muted">@sale.SaleDate.ToString("hh:mm tt")</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(sale.CustomerName))
                                        {
                                            <span>@sale.CustomerName</span><br>
                                            <small class="text-muted">@sale.CustomerPhone</small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Walk-in</span>
                                        }
                                    </td>
                                    <td class="text-end">₹@sale.SubTotal.ToString("N2")</td>
                                    <td class="text-end">₹@sale.TotalGSTAmount.ToString("N2")</td>
                                    <td class="text-end text-success">
                                        @if (sale.DiscountAmount > 0)
                                        {
                                            <span>-₹@sale.DiscountAmount.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td class="text-end"><strong class="text-primary">₹@sale.TotalAmount.ToString("N2")</strong></td>
                                    <td>
                                        <span class="badge @(sale.PaymentMethod == PaymentMethod.COD ? "bg-secondary" : "bg-success")">
                                            @(sale.PaymentMethod == PaymentMethod.COD ? "Cash" : sale.PaymentMethod.ToString())
                                        </span>
                                    </td>
                                    <td><small>@sale.CreatedByName</small></td>
                                    <td class="text-center">
                                        <a asp-action="Invoice" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-primary" target="_blank" title="View Invoice">
                                            <i class="fas fa-file-invoice"></i>
                                        </a>
                                        <a asp-action="SaleDetails" asp-route-id="@sale.Id" class="btn btn-sm btn-outline-info" title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4">
                                    <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                                    <p class="text-muted mb-0">No sales found</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer">
                    <nav>
                        <ul class="pagination justify-content-center mb-0">
                            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Sales" asp-route-page="@(Model.CurrentPage - 1)" 
                                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Previous</a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Sales" asp-route-page="@i"
                                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Sales" asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                                   asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</section>
