@model OfflineSaleViewModel
@inject MedicalStoreERP.Services.IAppSettingsService AppSettings
@{
    ViewData["Title"] = "Invoice";
    Layout = null;
    var settings = AppSettings.GetCachedSettings();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice - @Model.InvoiceNumber</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #fff;
            color: #333;
            font-size: 14px;
        }
        .invoice-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .invoice-header {
            border-bottom: 3px solid #198754;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        .company-name {
            color: #198754;
            font-size: 24px;
            font-weight: bold;
        }
        .invoice-title {
            font-size: 20px;
            color: #333;
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        .invoice-box {
            background: #f8f9fa;
            padding: 12px;
            border-radius: 6px;
            margin-bottom: 15px;
        }
        .table thead th {
            background: #198754;
            color: white;
            font-weight: 500;
            border: none;
            font-size: 13px;
            padding: 8px;
        }
        .table tbody td {
            vertical-align: middle;
            padding: 8px;
            font-size: 13px;
        }
        .total-section {
            background: #f8f9fa;
            padding: 12px;
            border-radius: 6px;
        }
        .grand-total {
            font-size: 18px;
            color: #198754;
            font-weight: bold;
        }
        .footer-note {
            border-top: 1px solid #dee2e6;
            padding-top: 15px;
            margin-top: 20px;
            text-align: center;
            color: #6c757d;
            font-size: 12px;
        }
        .gst-info {
            font-size: 11px;
            color: #6c757d;
        }
        @@media print {
            body {
                print-color-adjust: exact;
                -webkit-print-color-adjust: exact;
            }
            .no-print {
                display: none !important;
            }
            .invoice-container {
                padding: 0;
                max-width: 100%;
            }
            .page-break {
                page-break-after: always;
            }
        }
        @@page {
            size: A4;
            margin: 10mm;
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Print Controls -->
        <div class="no-print mb-3 d-flex gap-2">
            <button onclick="window.print()" class="btn btn-success">
                <i class="fas fa-print me-2"></i>Print Invoice
            </button>
            <a href="@Url.Action("Index")" class="btn btn-primary">
                <i class="fas fa-cash-register me-2"></i>New Sale
            </a>
            <a href="@Url.Action("Sales")" class="btn btn-secondary">
                <i class="fas fa-list me-2"></i>All Sales
            </a>
        </div>

        <!-- Invoice Header -->
        <div class="invoice-header">
            <div class="row align-items-center">
                <div class="col-7">
                    <div class="company-name">@settings.AppName</div>
                    <div class="text-muted small">
                        @settings.ContactAddress, @settings.ContactCity<br>
                        @settings.ContactState - @settings.ContactPinCode | Phone: @settings.ContactPhone<br>
                        @if (!string.IsNullOrEmpty(settings.GSTIN))
                        {
                            <strong>GSTIN: @settings.GSTIN</strong>
                        }
                        @if (!string.IsNullOrEmpty(settings.DrugLicenseNo))
                        {
                            <br><span>Drug License: @settings.DrugLicenseNo</span>
                        }
                    </div>
                </div>
                <div class="col-5 text-end">
                    <div class="invoice-title">Tax Invoice</div>
                    <div class="mt-2 small">
                        <strong>Invoice #:</strong> @Model.InvoiceNumber<br>
                        <strong>Date:</strong> @Model.SaleDate.ToString("dd MMM yyyy")<br>
                        <strong>Time:</strong> @Model.SaleDate.ToString("hh:mm tt")
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Details -->
        @if (!string.IsNullOrEmpty(Model.CustomerName) || !string.IsNullOrEmpty(Model.CustomerPhone))
        {
            <div class="invoice-box">
                <div class="row">
                    <div class="col-6">
                        <strong class="text-muted small">BILL TO:</strong><br>
                        @if (!string.IsNullOrEmpty(Model.CustomerName))
                        {
                            <strong>@Model.CustomerName</strong><br>
                        }
                        @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                        {
                            <span>Phone: @Model.CustomerPhone</span><br>
                        }
                        @if (!string.IsNullOrEmpty(Model.CustomerAddress))
                        {
                            <span>@Model.CustomerAddress</span>
                        }
                    </div>
                    <div class="col-6 text-end">
                        <strong class="text-muted small">PAYMENT:</strong><br>
                        <span class="badge @(Model.PaymentMethod == PaymentMethod.COD ? "bg-secondary" : "bg-success")">
                            @(Model.PaymentMethod == PaymentMethod.COD ? "Cash" : Model.PaymentMethod.ToString())
                        </span>
                    </div>
                </div>
            </div>
        }

        <!-- Items Table -->
        <table class="table table-bordered mb-3">
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 30%;">Description</th>
                    <th class="text-center" style="width: 10%;">HSN</th>
                    <th class="text-center" style="width: 8%;">Qty</th>
                    <th class="text-end" style="width: 12%;">Rate</th>
                    <th class="text-center" style="width: 10%;">GST</th>
                    <th class="text-end" style="width: 12%;">GST Amt</th>
                    <th class="text-end" style="width: 13%;">Total</th>
                </tr>
            </thead>
            <tbody>
                @{ var index = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@index</td>
                        <td>
                            <strong>@item.MedicineName</strong><br>
                            <small class="text-muted">Batch: @item.BatchNo</small>
                        </td>
                        <td class="text-center">@item.HSNCode</td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                        <td class="text-center">@item.GSTPercent%</td>
                        <td class="text-end">₹@item.GSTAmount.ToString("N2")</td>
                        <td class="text-end"><strong>₹@item.TotalPrice.ToString("N2")</strong></td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>

        <!-- Totals & GST Summary -->
        <div class="row">
            <div class="col-6">
                <!-- GST Summary -->
                <div class="invoice-box">
                    <strong class="text-muted small">GST SUMMARY</strong>
                    <table class="table table-sm table-borderless mb-0 mt-2">
                        <tr>
                            <td class="py-1">CGST</td>
                            <td class="text-end py-1">₹@Model.CGSTAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="py-1">SGST</td>
                            <td class="text-end py-1">₹@Model.SGSTAmount.ToString("N2")</td>
                        </tr>
                        <tr class="border-top">
                            <td class="py-1"><strong>Total GST</strong></td>
                            <td class="text-end py-1"><strong>₹@Model.TotalGSTAmount.ToString("N2")</strong></td>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="col-6">
                <!-- Amount Summary -->
                <div class="total-section">
                    <table class="table table-sm table-borderless mb-0">
                        <tr>
                            <td class="py-1">Subtotal</td>
                            <td class="text-end py-1">₹@Model.SubTotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="py-1">GST</td>
                            <td class="text-end py-1">₹@Model.TotalGSTAmount.ToString("N2")</td>
                        </tr>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr class="text-success">
                                <td class="py-1">Discount</td>
                                <td class="text-end py-1">-₹@Model.DiscountAmount.ToString("N2")</td>
                            </tr>
                        }
                        <tr class="border-top">
                            <td class="grand-total py-2">Grand Total</td>
                            <td class="text-end grand-total py-2">₹@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td class="py-1">Amount Received</td>
                            <td class="text-end py-1">₹@Model.AmountReceived.ToString("N2")</td>
                        </tr>
                        @if (Model.ChangeAmount > 0)
                        {
                            <tr class="text-success">
                                <td class="py-1">Change</td>
                                <td class="text-end py-1">₹@Model.ChangeAmount.ToString("N2")</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

        <!-- Amount in Words -->
        <div class="mt-3 p-2 bg-light rounded">
            <small class="text-muted">Amount in Words:</small><br>
            <strong>Rupees @ConvertToWords((int)Math.Round(Model.TotalAmount)) Only</strong>
        </div>

        <!-- Footer -->
        <div class="footer-note">
            <div class="row">
                <div class="col-6 text-start">
                    <small>Cashier: @(Model.CreatedByName ?? "Admin")</small>
                </div>
                <div class="col-6 text-end">
                    <small>Authorized Signatory</small>
                </div>
            </div>
            <hr class="my-2">
            <p class="mb-1"><strong>Thank you for your purchase!</strong></p>
            <p class="mb-0">This is a computer-generated invoice. | For queries: @settings.ContactEmail</p>
        </div>
    </div>

    <script src="https://kit.fontawesome.com/your-kit-id.js" crossorigin="anonymous"></script>
    <script>
        // Auto-print on load (optional - uncomment if needed)
        // window.onload = function() { window.print(); }
    </script>
</body>
</html>

@functions {
    private string ConvertToWords(int number)
    {
        if (number == 0) return "Zero";

        string[] ones = { "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten",
                         "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
        string[] tens = { "", "", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

        string words = "";

        if (number >= 10000000)
        {
            words += ConvertToWords(number / 10000000) + " Crore ";
            number %= 10000000;
        }

        if (number >= 100000)
        {
            words += ConvertToWords(number / 100000) + " Lakh ";
            number %= 100000;
        }

        if (number >= 1000)
        {
            words += ConvertToWords(number / 1000) + " Thousand ";
            number %= 1000;
        }

        if (number >= 100)
        {
            words += ones[number / 100] + " Hundred ";
            number %= 100;
        }

        if (number > 0)
        {
            if (number < 20)
                words += ones[number];
            else
                words += tens[number / 10] + " " + ones[number % 10];
        }

        return words.Trim();
    }
}
