@model GRNCreateViewModel
@{
    ViewData["Title"] = "Create GRN";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Create GRN</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">GRN</a></li>
                    <li class="breadcrumb-item active">Create</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <form asp-action="Create" method="post" id="grnForm">
            <div class="row">
                <div class="col-lg-8">
                    <!-- Supplier & Invoice Info -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-file-alt me-2"></i>GRN Information</h3>
                        </div>
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="SupplierId" class="form-label">Supplier *</label>
                                    <select asp-for="SupplierId" class="form-select" asp-items="@ViewBag.Suppliers" required>
                                        <option value="">Select Supplier</option>
                                    </select>
                                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="SupplierInvoiceNo" class="form-label">Supplier Invoice No</label>
                                    <input asp-for="SupplierInvoiceNo" class="form-control">
                                    <span asp-validation-for="SupplierInvoiceNo" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="GRNDate" class="form-label">GRN Date *</label>
                                    <input asp-for="GRNDate" type="date" class="form-control" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Notes" class="form-label">Notes</label>
                                    <input asp-for="Notes" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Items -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-list me-2"></i>Items</h3>
                            <div class="card-tools">
                                <button type="button" class="btn btn-primary btn-sm" id="addItemBtn">
                                    <i class="fas fa-plus me-1"></i>Add Item
                                </button>
                            </div>
                        </div>
                        <div class="card-body table-responsive p-0">
                            <table class="table" id="itemsTable">
                                <thead>
                                    <tr>
                                        <th width="250">Medicine</th>
                                        <th>Batch #</th>
                                        <th>Qty</th>
                                        <th>Purchase Price</th>
                                        <th>MRP</th>
                                        <th>Expiry</th>
                                        <th>Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsBody">
                                    <!-- Dynamic rows added here -->
                                </tbody>
                                <tfoot>
                                    <tr class="table-light">
                                        <td colspan="6" class="text-end"><strong>Grand Total:</strong></td>
                                        <td><strong id="grandTotal">₹0.00</strong></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <!-- Search Medicine -->
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="fas fa-search me-2"></i>Search Medicine</h3>
                        </div>
                        <div class="card-body">
                            <input type="text" id="medicineSearch" class="form-control" placeholder="Type to search medicines...">
                            <div id="searchResults" class="list-group mt-2" style="max-height: 300px; overflow-y: auto;"></div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="card">
                        <div class="card-body">
                            <button type="submit" class="btn btn-primary w-100 mb-2">
                                <i class="fas fa-save me-2"></i>Save GRN
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-times me-2"></i>Cancel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <script>
        let itemIndex = 0;

        // Search medicine
        $('#medicineSearch').on('input', function() {
            var term = $(this).val();
            if (term.length < 2) {
                $('#searchResults').empty();
                return;
            }

            $.get('@Url.Action("SearchMedicines")', { term: term }, function(data) {
                var html = '';
                data.forEach(function(m) {
                    html += `
                        <a href="#" class="list-group-item list-group-item-action" 
                           onclick="addMedicine(${m.id}, '${m.name}', '${m.batchNumber}', ${m.costPrice}, ${m.sellingPrice}, '${m.expiryDate}'); return false;">
                            <strong>${m.name}</strong><br>
                            <small class="text-muted">${m.genericName} | Stock: ${m.stockQuantity}</small>
                        </a>
                    `;
                });
                $('#searchResults').html(html || '<div class="text-muted p-2">No results found</div>');
            });
        });

        function addMedicine(id, name, batch, cost, sell, expiry) {
            addItemRow(id, name, batch, 1, cost, sell, expiry);
            $('#medicineSearch').val('');
            $('#searchResults').empty();
        }

        $('#addItemBtn').click(function() {
            addItemRow(0, '', '', 1, 0, 0, '');
        });

        function addItemRow(medicineId, name, batch, qty, cost, sell, expiry) {
            var row = `
                <tr data-index="${itemIndex}">
                    <td>
                        <input type="hidden" name="Items[${itemIndex}].MedicineId" value="${medicineId}">
                        <input type="text" class="form-control form-control-sm" value="${name}" readonly 
                               placeholder="Search above">
                    </td>
                    <td>
                        <input type="text" name="Items[${itemIndex}].BatchNo" class="form-control form-control-sm" 
                               value="${batch}" required>
                    </td>
                    <td>
                        <input type="number" name="Items[${itemIndex}].Quantity" class="form-control form-control-sm qty-input" 
                               value="${qty}" min="1" required onchange="calculateTotal(this)">
                    </td>
                    <td>
                        <input type="number" name="Items[${itemIndex}].PurchasePrice" class="form-control form-control-sm cost-input" 
                               value="${cost}" step="0.01" required onchange="calculateTotal(this)">
                    </td>
                    <td>
                        <input type="number" name="Items[${itemIndex}].MRP" class="form-control form-control-sm" 
                               value="${sell}" step="0.01" required>
                    </td>
                    <td>
                        <input type="date" name="Items[${itemIndex}].ExpiryDate" class="form-control form-control-sm" 
                               value="${expiry}" required>
                    </td>
                    <td class="row-total">₹${(qty * cost).toFixed(2)}</td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">
                            <i class="fas fa-times"></i>
                        </button>
                    </td>
                </tr>
            `;
            $('#itemsBody').append(row);
            itemIndex++;
            updateGrandTotal();
        }

        function removeRow(btn) {
            $(btn).closest('tr').remove();
            updateGrandTotal();
        }

        function calculateTotal(input) {
            var row = $(input).closest('tr');
            var qty = parseFloat(row.find('.qty-input').val()) || 0;
            var cost = parseFloat(row.find('.cost-input').val()) || 0;
            var total = qty * cost;
            row.find('.row-total').text('₹' + total.toFixed(2));
            updateGrandTotal();
        }

        function updateGrandTotal() {
            var total = 0;
            $('#itemsBody tr').each(function() {
                var qty = parseFloat($(this).find('.qty-input').val()) || 0;
                var cost = parseFloat($(this).find('.cost-input').val()) || 0;
                total += qty * cost;
            });
            $('#grandTotal').text('₹' + total.toFixed(2));
        }
    </script>
}
