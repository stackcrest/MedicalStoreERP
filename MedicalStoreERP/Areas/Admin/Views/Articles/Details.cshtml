@model ArticleViewModel
@{
    ViewData["Title"] = "Article Details";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    <i class="fas fa-newspaper me-2"></i>Article Details
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Articles</a></li>
                    <li class="breadcrumb-item active">Details</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <!-- Main Content -->
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="card-title">@Model.Title</h3>
                            <div>
                                @if (Model.IsPublished)
                                {
                                    <span class="badge bg-success"><i class="fas fa-check me-1"></i>Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary"><i class="fas fa-eye-slash me-1"></i>Draft</span>
                                }
                                @if (Model.IsFeatured)
                                {
                                    <span class="badge bg-warning"><i class="fas fa-star me-1"></i>Featured</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.FeaturedImageUrl))
                        {
                            <div class="mb-4">
                                <img src="@Model.FeaturedImageUrl" class="img-fluid rounded" alt="@Model.Title" style="max-height: 400px; width: 100%; object-fit: cover;">
                            </div>
                        }

                        <div class="mb-3">
                            <span class="badge bg-info me-2">@Model.Category</span>
                            @if (!string.IsNullOrEmpty(Model.Tags))
                            {
                                @foreach (var tag in Model.TagList)
                                {
                                    <span class="badge bg-outline-secondary border me-1">#@tag</span>
                                }
                            }
                        </div>

                        <h4>Summary</h4>
                        <p class="lead text-muted">@Model.Summary</p>

                        <hr />

                        <h4>Content</h4>
                        <div class="article-content">
                            @Html.Raw(Model.Content.Replace("\n", "<br/>"))
                        </div>

                        @if (!string.IsNullOrEmpty(Model.VideoUrl))
                        {
                            <hr />
                            <h4><i class="fas fa-video me-2"></i>Video</h4>
                            <div class="ratio ratio-16x9">
                                @if (Model.VideoUrl.Contains("youtube.com") || Model.VideoUrl.Contains("youtu.be"))
                                {
                                    var videoId = Model.VideoUrl.Contains("v=") 
                                        ? Model.VideoUrl.Split("v=")[1].Split("&")[0]
                                        : Model.VideoUrl.Split("/").Last();
                                    <iframe src="https://www.youtube.com/embed/@videoId" allowfullscreen></iframe>
                                }
                                else
                                {
                                    <video controls class="w-100">
                                        <source src="@Model.VideoUrl" type="video/mp4">
                                    </video>
                                }
                            </div>
                        }

                        @if (Model.Links.Any())
                        {
                            <hr />
                            <h4><i class="fas fa-link me-2"></i>External References</h4>
                            <ul class="list-group">
                                @foreach (var link in Model.Links)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            @if (link.Type == "video")
                                            {
                                                <i class="fas fa-video text-danger me-2"></i>
                                            }
                                            else if (link.Type == "pdf")
                                            {
                                                <i class="fas fa-file-pdf text-danger me-2"></i>
                                            }
                                            else if (link.Type == "image")
                                            {
                                                <i class="fas fa-image text-success me-2"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-external-link-alt text-primary me-2"></i>
                                            }
                                            @link.Title
                                        </span>
                                        <a href="@link.Url" target="_blank" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-external-link-alt"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <!-- Comments Section -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-comments me-2"></i>Comments (@Model.Comments.Count)
                        </h3>
                    </div>
                    <div class="card-body">
                        @if (Model.Comments.Any())
                        {
                            @foreach (var comment in Model.Comments)
                            {
                                <div class="d-flex mb-3 @(comment.IsApproved ? "" : "opacity-50")">
                                    <div class="me-3">
                                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                            @comment.Name?.FirstOrDefault()
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>@comment.Name</strong>
                                                @if (!comment.IsApproved)
                                                {
                                                    <span class="badge bg-warning ms-2">Pending</span>
                                                }
                                            </div>
                                            <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                        </div>
                                        <p class="mb-0 mt-1">@comment.Content</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-comments fa-3x mb-2"></i>
                                <p>No comments yet</p>
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-action="Comments" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                            <i class="fas fa-cog me-2"></i>Manage Comments
                        </a>
                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- Actions -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Actions</h3>
                    </div>
                    <div class="card-body">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary w-100 mb-2">
                            <i class="fas fa-edit me-2"></i>Edit Article
                        </a>
                        <a href="/Blog/Read/@Model.Slug" target="_blank" class="btn btn-outline-info w-100 mb-2">
                            <i class="fas fa-eye me-2"></i>View Public Page
                        </a>
                        <button type="button" class="btn btn-outline-danger w-100" onclick="confirmDelete(@Model.Id, '@Model.Title.Replace("'", "\\'")'))">
                            <i class="fas fa-trash me-2"></i>Delete Article
                        </button>
                    </div>
                </div>

                <!-- Statistics -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Statistics</h3>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <h3 class="text-primary mb-0">@Model.ViewCount</h3>
                                <small class="text-muted">Views</small>
                            </div>
                            <div class="col-6">
                                <h3 class="text-success mb-0">@Model.LikeCount</h3>
                                <small class="text-muted">Likes</small>
                            </div>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col-6 border-end">
                                <h3 class="text-info mb-0">@Model.CommentCount</h3>
                                <small class="text-muted">Comments</small>
                            </div>
                            <div class="col-6">
                                <h3 class="text-warning mb-0">@Model.ReadTime</h3>
                                <small class="text-muted">Read Time</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Meta Info -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Article Info</h3>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <td class="text-muted">Author</td>
                                <td><strong>@Model.AuthorName</strong></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Category</td>
                                <td><span class="badge bg-info">@Model.Category</span></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Created</td>
                                <td>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                            @if (Model.PublishedAt.HasValue)
                            {
                                <tr>
                                    <td class="text-muted">Published</td>
                                    <td>@Model.PublishedAt.Value.ToString("MMM dd, yyyy HH:mm")</td>
                                </tr>
                            }
                            <tr>
                                <td class="text-muted">Slug</td>
                                <td><code>@Model.Slug</code></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Quick Toggle -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Quick Settings</h3>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span>Published</span>
                            <button class="btn btn-sm @(Model.IsPublished ? "btn-success" : "btn-secondary")" id="publishBtn"
                                    onclick="togglePublish(@Model.Id)">
                                @(Model.IsPublished ? "Yes" : "No")
                            </button>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span>Featured</span>
                            <button class="btn btn-sm @(Model.IsFeatured ? "btn-warning" : "btn-secondary")" id="featuredBtn"
                                    onclick="toggleFeatured(@Model.Id)">
                                @(Model.IsFeatured ? "Yes" : "No")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete "<strong id="deleteArticleTitle"></strong>"?</p>
                <p class="text-danger mb-0">This action cannot be undone!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePublish(id) {
            $.post('/Admin/Articles/TogglePublish/' + id, function(response) {
                if (response.success) {
                    var btn = $('#publishBtn');
                    if (response.isPublished) {
                        btn.removeClass('btn-secondary').addClass('btn-success').text('Yes');
                    } else {
                        btn.removeClass('btn-success').addClass('btn-secondary').text('No');
                    }
                }
            });
        }

        function toggleFeatured(id) {
            $.post('/Admin/Articles/ToggleFeatured/' + id, function(response) {
                if (response.success) {
                    var btn = $('#featuredBtn');
                    if (response.isFeatured) {
                        btn.removeClass('btn-secondary').addClass('btn-warning').text('Yes');
                    } else {
                        btn.removeClass('btn-warning').addClass('btn-secondary').text('No');
                    }
                }
            });
        }

        function confirmDelete(id, title) {
            $('#deleteArticleTitle').text(title);
            $('#deleteForm').attr('action', '/Admin/Articles/Delete/' + id);
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>

    <style>
        .article-content {
            line-height: 1.8;
        }
    </style>
}
